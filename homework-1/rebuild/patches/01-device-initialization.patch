+"""Inference-only Qwen3.5 model and Qwen3.5 MoE model compatible with HuggingFace weights."""
+
+import pytest
+import torch
+from tokenspeed_kernel.platform import current_platform
+from transformers import Qwen3_5TextConfig
+
+from tokenspeed.runtime.distributed.mapping import Mapping
+from tokenspeed.runtime.models.qwen3_5 import Qwen3_5ForCausalLM
+
+
+@pytest.mark.skipif(not current_platform().is_npu, reason="Ascend initialization regression")
+def test_qwen35_model_can_initialize_without_cuda():
+    config = Qwen3_5TextConfig(
+        vocab_size=32,
+        hidden_size=16,
+        intermediate_size=32,
+        num_hidden_layers=0,
+    )
+    with torch.device("meta"):
+        model = Qwen3_5ForCausalLM(config, Mapping(rank=0, world_size=1))
+
+    assert len(model.layers) == 0
+    assert model.embed_tokens.weight.shape[1] == 16
+    assert model.embed_tokens.weight.device.type == "meta"
+    assert model.norm.weight.numel() == 16
