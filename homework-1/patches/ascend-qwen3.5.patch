+"""Device-local eager causal FIR convolution; see docs/causal-conv.md.
+
+Only routing/schedule metadata is synchronized to Python. CPU execution is for
+independent tests, not an NPU fallback. There is no tokenspeed-kernel dependency.
+"""
+
+from __future__ import annotations
+
+import torch
+import torch.nn.functional as F
+
+_FLOAT_DTYPES = (torch.float16, torch.bfloat16, torch.float32)
+
+
+def _vector(tensor: torch.Tensor, name: str, size: int) -> list[int]:
+    if tensor.shape != (size,) or tensor.dtype not in (torch.int32, torch.int64):
+        raise ValueError(f"{name} must be an int32/int64 vector of length {size}")
+    # Eager metadata synchronization only. Never copy activations to the host.
+    return tensor.tolist()
+
+
+def _options(activation: bool | str | None, pad_slot_id: int, validate_data: bool) -> bool:
+    if type(validate_data) is not bool:
+        raise ValueError("validate_data must be a bool; validation is always enabled")
+    if type(pad_slot_id) is not int or pad_slot_id >= 0:
+        raise ValueError("pad_slot_id must be a negative integer")
+    if activation is None or activation is False:
+        return False
+    if activation is True or activation in ("silu", "swish"):
+        return True
+    raise ValueError("activation must be None, False, True, 'silu' or 'swish'")
+
+
+def _geometry(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None,
+    state: torch.Tensor,
+    channels: int,
+) -> torch.Tensor:
+    if x.device.type not in ("cpu", "npu") or x.dtype not in _FLOAT_DTYPES:
+        raise ValueError("x must be float16, bfloat16 or float32 on CPU or NPU")
+    if weight.ndim != 2 or weight.shape[0] != channels or channels <= 0:
+        raise ValueError("weight must have shape [C,W] with C > 0")
+    width = weight.shape[1]
+    if width not in (2, 3, 4, 5):
+        raise ValueError("Ascend causal convolution supports widths 2, 3, 4 and 5")
+    if not isinstance(state, torch.Tensor):
+        raise ValueError("Ascend causal convolution requires a state pool")
+    for name, value in (("weight", weight), ("bias", bias), ("state", state)):
+        if value is not None and (
+            value.device != x.device or value.dtype not in _FLOAT_DTYPES
+        ):
+            raise ValueError(f"{name} must be floating point on the input device")
+    if bias is not None and bias.shape != (channels,):
+        raise ValueError("bias must have shape [C]")
+    if state.dtype != x.dtype or state.ndim != 3:
+        raise ValueError("state must be rank three with the input dtype")
+    # Match ops.conv._state_layout: width-major wins when C == W - 1.
+    if state.shape[1:] == (width - 1, channels):
+        view = state.transpose(1, 2)
+    elif state.shape[1:] == (channels, width - 1):
+        view = state
+    else:
+        raise ValueError(
+            "state must be [S,C,W-1] or [S,W-1,C]; "
+            "extended/ring states are unsupported"
+        )
+    _writable(view, "state")
+    return view
+
+
+def _writable(tensor: torch.Tensor, name: str) -> None:
+    if any(
+        size > 1 and stride <= 0
+        for size, stride in zip(tensor.shape, tensor.stride())
+    ):
+        raise ValueError(f"{name} must not have broadcast or negative strides")
+
+
+def _indices(
+    indices: torch.Tensor | None, name: str, batch: int, slots: int
+) -> list[int]:
+    values = list(range(batch)) if indices is None else _vector(indices, name, batch)
+    if any(index >= slots for index in values):
+        raise ValueError(f"{name} contains an out-of-range state index")
+    # All negative indices are padding, not Python's wraparound indexing.
+    return values
+
+
+def _unique_writes(indices: list[int]) -> None:
+    live = [index for index in indices if index >= 0]
+    if len(live) != len(set(live)):
+        raise ValueError("multiple active requests must not write the same state slot")
+
+
+def _convolve(
+    sequence: torch.Tensor,
+    history: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None,
+    *,
+    silu: bool,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    length = sequence.shape[1]
+    window = history.shape[1]
+    joined = torch.cat((history, sequence), dim=1)
+    values = joined.float()
+    taps = weight.float()
+    acc = torch.zeros(sequence.shape, dtype=torch.float32, device=sequence.device)
+    if bias is not None:
+        acc.add_(bias.float()[:, None])
+    # Tap W-1 multiplies the current token; history is oldest first.
+    for tap in range(weight.shape[1]):
+        acc.add_(values[:, tap : tap + length] * taps[:, tap : tap + 1])
+    if silu:
+        acc = F.silu(acc)
+    return acc.to(sequence.dtype), joined[:, -window:]
+
+
+def _schedule(
+    bounds: list[int],
+    batch_indices: torch.Tensor,
+    chunk_offsets: torch.Tensor,
+    block_m: int,
+    cu_seqlens_cpu: torch.Tensor | None,
+    device: torch.device,
+) -> None:
+    if type(block_m) is not int or block_m <= 0:
+        raise ValueError("block_m must be a positive integer")
+    if batch_indices.ndim != 1:
+        raise ValueError("batch_indices must be a vector")
+    size = batch_indices.numel()
+    batches = _vector(batch_indices, "batch_indices", size)
+    chunks = _vector(chunk_offsets, "chunk_offsets", size)
+    if batch_indices.device != device or chunk_offsets.device != device:
+        raise ValueError("convolution schedule must be on the input device")
+    if cu_seqlens_cpu is not None:
+        if cu_seqlens_cpu.device.type != "cpu":
+            raise ValueError("cu_seqlens_cpu must be on CPU")
+        if _vector(cu_seqlens_cpu, "cu_seqlens_cpu", len(bounds)) != bounds:
+            raise ValueError("host and device convolution boundaries disagree")
+    expected = {
+        (request, chunk)
+        for request, (start, end) in enumerate(zip(bounds, bounds[1:]))
+        for chunk in range((end - start + block_m - 1) // block_m)
+    }
+    actual = []
+    for request, chunk in zip(batches, chunks):
+        if request == -1:  # Inactive capacity-schedule programs.
+            continue
+        if (request, chunk) not in expected:
+            raise ValueError("convolution schedule contains an invalid request/chunk")
+        actual.append((request, chunk))
+    if len(actual) != len(expected) or set(actual) != expected:
+        raise ValueError("convolution schedule must cover each live chunk exactly once")
+
+
+@torch.no_grad()
+def launch_causal_conv1d_prefill(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None,
+    conv_states: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    cache_indices: torch.Tensor | None = None,
+    has_initial_state: torch.Tensor | None = None,
+    activation: bool | str | None = "silu",
+    pad_slot_id: int = -1,
+    validate_data: bool = False,
+    *,
+    batch_indices: torch.Tensor,
+    chunk_offsets: torch.Tensor,
+    block_m: int,
+    cu_seqlens_cpu: torch.Tensor | None,
+) -> torch.Tensor:
+    """Convolve packed [C,T] sequences, returning a separate [C,T] tensor.
+
+    Args:
+        x, weight, bias: Packed input, [C,W] FIR taps and optional [C] bias.
+        conv_states: In/out [S,C,W-1] or [S,W-1,C] raw-input window pool.
+        query_start_loc: Int32/int64 [B+1] monotone boundaries from 0 to at most
+            T. Unassigned trailing token capacity produces zero output.
+        cache_indices: Optional [B] state slots; omitted means arange(B).
+        has_initial_state: Optional bool [B]; absent/False resets history to zero.
+        activation: None/False or silu/swish/True.
+        pad_slot_id: Negative padding sentinel; all negative slots are skipped.
+        validate_data: ABI compatibility; both values perform full validation.
+        batch_indices, chunk_offsets, block_m, cu_seqlens_cpu: Read-only upstream
+            prefill schedule fields, checked against query_start_loc, including
+            optional host boundaries. Inactive capacity programs have batch -1.
+
+    Returns:
+        Output in x.dtype/device, without changing x. Each nonempty, nonpadding
+        sequence writes its final raw window. Empty sequences leave state alone;
+        padded sequences produce zeros and never access state.
+    """
+    silu = _options(activation, pad_slot_id, validate_data)
+    if x.ndim != 2:
+        raise ValueError("prefill x must have shape [C,T]")
+    state = _geometry(x, weight, bias, conv_states, x.shape[0])
+    if query_start_loc.ndim != 1 or query_start_loc.numel() == 0:
+        raise ValueError("query_start_loc must have shape [B+1]")
+    bounds = _vector(query_start_loc, "query_start_loc", query_start_loc.numel())
+    if (
+        bounds[0] != 0
+        or bounds[-1] > x.shape[1]
+        or any(a > b for a, b in zip(bounds, bounds[1:]))
+    ):
+        raise ValueError("query_start_loc must be monotone from zero within T")
+    batch = len(bounds) - 1
+    slots = _indices(cache_indices, "cache_indices", batch, state.shape[0])
+    if has_initial_state is None:
+        initial = [False] * batch
+    else:
+        if (
+            has_initial_state.shape != (batch,)
+            or has_initial_state.dtype != torch.bool
+        ):
+            raise ValueError("has_initial_state must be a bool vector of length B")
+        initial = has_initial_state.tolist()
+    _schedule(bounds, batch_indices, chunk_offsets, block_m, cu_seqlens_cpu, x.device)
+    active = [i for i in range(batch) if slots[i] >= 0 and bounds[i] < bounds[i + 1]]
+    _unique_writes([slots[i] for i in active])
+    # Snapshot before any state write, including repeated/shared source storage.
+    histories = {
+        i: state[slots[i]].clone() if initial[i] else torch.zeros_like(state[slots[i]])
+        for i in active
+    }
+    out = torch.zeros_like(x)
+    for i in active:
+        start, end = bounds[i : i + 2]
+        values, final = _convolve(x[:, start:end], histories[i], weight, bias, silu=silu)
+        out[:, start:end].copy_(values)
+        state[slots[i]].copy_(final)
+    return out
+
+
+@torch.no_grad()
+def launch_causal_conv1d_update(
+    x: torch.Tensor,
+    conv_state: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None = None,
+    activation: bool | str | None = None,
+    cache_seqlens: torch.Tensor | None = None,
+    conv_state_indices: torch.Tensor | None = None,
+    num_accepted_tokens: torch.Tensor | None = None,
+    intermediate_conv_window: torch.Tensor | None = None,
+    output_state_indices: torch.Tensor | None = None,
+    pad_slot_id: int = -1,
+    validate_data: bool = False,
+    *,
+    parent_indices: torch.Tensor | None,
+) -> torch.Tensor:
+    """Greedy one-token update, overwriting and returning x (the upstream ABI).
+
+    Args:
+        x: [B,C] or [B,C,1]; [B,C,0] is an empty no-op.
+        conv_state, weight, bias, activation: Same pool/taps/options as prefill.
+        cache_seqlens, num_accepted_tokens, intermediate_conv_window,
+            parent_indices: Must be None; ring/speculative/tree paths are rejected.
+        conv_state_indices: Optional int32/int64 [B] source slots (else arange).
+        output_state_indices: Optional int32/int64 [B,1] destinations. If absent,
+            update source slots in place. Negative destinations suppress writes;
+            negative sources skip both output computation and state writes.
+        pad_slot_id, validate_data: As in prefill; validation is always enabled.
+
+    Returns:
+        x, mutated in place with the convolved/activated output. Padded rows are
+        unchanged. Raw input, not the activated result, enters the state pool.
+        All source windows are snapshotted before writes, including crossing maps.
+    """
+    for name, option in (
+        ("cache_seqlens", cache_seqlens),
+        ("num_accepted_tokens", num_accepted_tokens),
+        ("intermediate_conv_window", intermediate_conv_window),
+        ("parent_indices", parent_indices),
+    ):
+        if option is not None:
+            raise ValueError(f"Ascend greedy causal convolution does not support {name}")
+    silu = _options(activation, pad_slot_id, validate_data)
+    if x.ndim not in (2, 3):
+        raise ValueError("update x must have shape [B,C] or [B,C,1]")
+    if x.ndim == 3 and x.shape[2] not in (0, 1):
+        raise ValueError(
+            "Ascend update supports one greedy token, "
+            "not multi-token/speculative updates"
+        )
+    state = _geometry(x, weight, bias, conv_state, x.shape[1])
+    _writable(x, "x")
+    batch = x.shape[0]
+    sources = _indices(conv_state_indices, "conv_state_indices", batch, state.shape[0])
+    if output_state_indices is None:
+        destinations = sources
+    else:
+        if output_state_indices.shape != (batch, 1):
+            raise ValueError("output_state_indices must have shape [B,1]")
+        destinations = _indices(
+            output_state_indices[:, 0], "output_state_indices", batch, state.shape[0]
+        )
+    if x.ndim == 3 and x.shape[2] == 0:
+        return x
+    active = [i for i, source in enumerate(sources) if source >= 0]
+    _unique_writes([destinations[i] for i in active])
+    # A destination may be another request's source. Gather *all* sources first.
+    histories = {i: state[sources[i]].clone() for i in active}
+    raw = x.unsqueeze(-1).clone() if x.ndim == 2 else x.clone()
+    for i in active:
+        values, final = _convolve(raw[i], histories[i], weight, bias, silu=silu)
+        if x.ndim == 2:
+            x[i].copy_(values[:, 0])
+        else:
+            x[i].copy_(values)
+        if destinations[i] >= 0:
+            state[destinations[i]].copy_(final)
+    return x
