+"""Direct CPU/device tests and NPU-only public registry integration tests.
+
+Select direct CPU tests with -k cpu, real device tests with -k npu. No mocks,
+weights, network or accelerator-to-CPU fallback are used by the implementation.
+"""
+
+import pytest
+import torch
+from tokenspeed_kernel_npu.ops.gdn import (
+    launch_gdn_chunk_prefill,
+    launch_gdn_decode_step,
+)
+
+
+@pytest.fixture(params=["cpu", "npu"])
+def device(request):
+    if request.param == "npu":
+        pytest.importorskip("torch_npu")
+        if not torch.npu.is_available():
+            pytest.skip("Ascend NPU required")
+    return request.param
+
+
+def _reference(
+    q, k, v, g, beta, initial, bounds, *, scale, normalize, round_normalized
+):
+    """Independent float64 K-major recurrence, one value head at a time."""
+    out = torch.empty(v.shape, dtype=q.dtype)
+    finals, snapshots = [], []
+    hq, hv, dim = q.shape[-2], v.shape[-2], q.shape[-1]
+    scale = dim**-0.5 if scale is None else scale
+    for seq, (begin, end) in enumerate(zip(bounds, bounds[1:])):
+        heads = [initial[seq, head].double().T.clone() for head in range(hv)]
+        history = []
+        for token in range(begin, end):
+            for head in range(hv):
+                group = head // (hv // hq)
+                query, key = q[0, token, group].double(), k[0, token, group].double()
+                if normalize:
+                    query = query / (query.dot(query) + 1e-6).sqrt()
+                    key = key / (key.dot(key) + 1e-6).sqrt()
+                    if round_normalized:
+                        query, key = query.to(q.dtype).double(), key.to(k.dtype).double()
+                decayed = heads[head] * g[0, token, head].double().exp()
+                delta = beta[0, token, head].double() * (
+                    v[0, token, head].double() - key @ decayed
+                )
+                heads[head] = decayed + torch.outer(key, delta)
+                out[0, token, head] = (query * scale) @ heads[head]
+            history.append(torch.stack([state.T for state in heads]).float())
+        finals.append(torch.stack([state.T for state in heads]).float())
+        snapshots.append(history)
+    return out, torch.stack(finals), snapshots
+
+
+def _inputs(lengths, dtype):
+    gen = torch.Generator().manual_seed(71)
+    total = sum(lengths)
+    q = (torch.randn(1, total, 2, 5, generator=gen) * 0.2).to(dtype)
+    k = (torch.randn(1, total, 2, 5, generator=gen) * 0.2).to(dtype)
+    if total:
+        # Near-zero norms distinguish additive epsilon from clamp normalization.
+        q[:, 0] = 1e-4
+        k[:, 0] = 2e-4
+    v = torch.randn(1, total, 4, 3, generator=gen).to(dtype)
+    g = -torch.rand(1, total, 4, generator=gen) * 0.3
+    beta = torch.rand(1, total, 4, generator=gen)
+    state = torch.randn(len(lengths), 4, 3, 5, generator=gen) * 0.2
+    bounds = [0]
+    for length in lengths:
+        bounds.append(bounds[-1] + length)
+    return q, k, v, g, beta, state, bounds
+
+
+def _prefill(args, device, *, normalize, final, scale, checkpoints=None):
+    q, k, v, g, beta, state, bounds = args
+    return launch_gdn_chunk_prefill(
+        q.to(device), k.to(device), v.to(device), g.to(device), beta.to(device),
+        scale=scale,
+        initial_state=state.to(device),
+        cu_seqlens=torch.tensor(bounds, dtype=torch.int32, device=device),
+        qk_l2norm=normalize,
+        output_final_state=final,
+        checkpoint_every_n_tokens=None if checkpoints is None else checkpoints[0],
+        checkpoint_states=None if checkpoints is None else checkpoints[1],
+        checkpoint_cu_starts=None if checkpoints is None else checkpoints[2],
+    )
+
+
+def _assert_close(actual, expected):
+    # FP32 recurrence and output cast: low-precision results can differ by one ULP.
+    if actual.dtype == torch.bfloat16:
+        rtol, atol = 8e-3, 4e-3
+    elif actual.dtype == torch.float16:
+        rtol, atol = 1e-3, 5e-4
+    else:
+        rtol, atol = 2e-5, 2e-6
+    torch.testing.assert_close(actual.cpu(), expected, rtol=rtol, atol=atol)
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16, torch.float16])
+@pytest.mark.parametrize("normalize", [False, True])
+@pytest.mark.parametrize("scale", [None, 0.37])
+@pytest.mark.parametrize("final", [False, True])
+def test_prefill_variable_batches(device, dtype, normalize, scale, final):
+    args = _inputs([3, 0, 5], dtype)
+    q, k, v, g, beta, state, bounds = args
+    expected, expected_state, _ = _reference(
+        q, k, v, g, beta, state, bounds,
+        scale=scale, normalize=normalize, round_normalized=True,
+    )
+    source = state.to(device)
+    saved = source.clone()
+    out, last = _prefill(
+        (*args[:5], source, bounds), device,
+        normalize=normalize, final=final, scale=scale,
+    )
+    assert out.dtype == dtype
+    _assert_close(out, expected)
+    torch.testing.assert_close(source, saved, rtol=0, atol=0)
+    if final:
+        assert last.dtype == torch.float32
+        _assert_close(last, expected_state)
+        # Empty sequences carry their input checkpoint unchanged.
+        torch.testing.assert_close(last[1], source[1], rtol=0, atol=0)
+    else:
+        assert last is None
+
+
+@pytest.mark.parametrize("interval", [64, 128])
+@pytest.mark.parametrize("final", [False, True])
+def test_prefill_real_checkpoints(device, interval, final):
+    args = _inputs([65, 0, 129], torch.float32)
+    q, k, v, g, beta, state, bounds = args
+    expected, last, history = _reference(
+        q, k, v, g, beta, state, bounds,
+        scale=None, normalize=True, round_normalized=True,
+    )
+    starts = [0, 65 // interval, 65 // interval, 65 // interval + 129 // interval]
+    checkpoints = torch.full((starts[-1], 4, 3, 5), float("nan"), device=device)
+    out, final_state = _prefill(
+        args, device, normalize=True, final=final, scale=None,
+        checkpoints=(
+            interval, checkpoints,
+            torch.tensor(starts, dtype=torch.int32, device=device),
+        ),
+    )
+    _assert_close(out, expected)
+    if final:
+        _assert_close(final_state, last)
+    else:
+        assert final_state is None
+    expected_checkpoints = torch.stack([
+        sequence[t - 1]
+        for sequence in history
+        for t in range(interval, len(sequence) + 1, interval)
+    ])
+    _assert_close(checkpoints, expected_checkpoints)
+    # A resumed suffix must continue from the actual checkpoint, not the final state.
+    if interval <= 65:
+        offset = interval
+        suffix = (
+            q[:, offset:65],
+            k[:, offset:65],
+            v[:, offset:65],
+            g[:, offset:65],
+            beta[:, offset:65],
+            checkpoints[:1],
+            [0, 65 - offset],
+        )
+        resumed, resumed_state = _prefill(
+            suffix, device, normalize=True, final=True, scale=None
+        )
+        _assert_close(resumed, out[:, offset:65].cpu())
+        _assert_close(resumed_state, last[:1])
+
+
+def _strided(tensor):
+    storage = torch.empty(
+        (*tensor.shape[:-1], tensor.shape[-1] * 2),
+        dtype=tensor.dtype, device=tensor.device,
+    )
+    result = storage[..., ::2]
+    result.copy_(tensor)
+    return result
+
+
+def _decode_args(device, dtype, *, strided):
+    gen = torch.Generator().manual_seed(47)
+    tensors = dict(
+        q=(torch.randn(5, 1, 2, 5, generator=gen) * 0.1).to(dtype),
+        k=(torch.randn(5, 1, 2, 5, generator=gen) * 0.1).to(dtype),
+        v=torch.randn(5, 1, 4, 3, generator=gen).to(dtype),
+        A_log=torch.randn(4, generator=gen).to(dtype),
+        a=torch.randn(5, 1, 4, generator=gen).to(dtype),
+        dt_bias=torch.randn(4, generator=gen).to(dtype),
+        b=torch.randn(5, 1, 4, generator=gen).to(dtype),
+        initial_state=torch.randn(9, 4, 3, 5, generator=gen),
+    )
+    # Cover the linear softplus branch and near-zero forget/update gates.
+    tensors["a"][0, 0] = torch.tensor([30, -50, 0, 20], dtype=dtype)
+    tensors["q"][1].zero_()
+    tensors["k"][1].zero_()
+    tensors["q"][4] = 1e-4
+    tensors["k"][4] = 2e-4
+    tensors = {name: value.to(device) for name, value in tensors.items()}
+    if strided:
+        tensors = {name: _strided(value) for name, value in tensors.items()}
+    return tensors
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.bfloat16, torch.float16])
+@pytest.mark.parametrize("normalize", [False, True])
+@pytest.mark.parametrize("strided", [False, True])
+@pytest.mark.parametrize("scale", [None, 0.0, 0.29])
+def test_decode_isolation_padding_and_destinations(
+    device, dtype, normalize, strided, scale
+):
+    args = _decode_args(device, dtype, strided=strided)
+    before = args["initial_state"].clone()
+    reads, writes = [2, 0, -1, 2, 4], [5, 6, 7, -1, 8]
+    host = {name: value.cpu() for name, value in args.items()}
+    expected_pool = before.cpu().clone()
+    expected_out = torch.zeros_like(host["v"])
+    for row, (src, dst) in enumerate(zip(reads, writes)):
+        if src < 0:
+            continue
+        gate = -host["A_log"].float().exp() * torch.nn.functional.softplus(
+            host["a"][row:row + 1].float() + host["dt_bias"].float()
+        )
+        expected, last, _ = _reference(
+            host["q"][row:row + 1],
+            host["k"][row:row + 1],
+            host["v"][row:row + 1],
+            gate,
+            host["b"][row:row + 1].float().sigmoid(),
+            host["initial_state"][src:src + 1],
+            [0, 1],
+            scale=scale, normalize=normalize, round_normalized=False,
+        )
+        expected_out[row:row + 1] = expected
+        if dst >= 0:
+            expected_pool[dst] = last[0]
+    out = launch_gdn_decode_step(
+        **args,
+        initial_state_indices=torch.tensor(reads, dtype=torch.int64, device=device),
+        output_state_indices=torch.tensor(writes, dtype=torch.int32, device=device),
+        scale=scale,
+        use_qk_l2norm=normalize,
+    )
+    assert out.dtype == dtype
+    _assert_close(out, expected_out)
+    _assert_close(args["initial_state"], expected_pool)
+    untouched = torch.tensor([0, 1, 2, 3, 4, 7], device=device)
+    torch.testing.assert_close(
+        args["initial_state"][untouched], before[untouched], rtol=0, atol=0
+    )
+    torch.testing.assert_close(out[2], torch.zeros_like(out[2]), rtol=0, atol=0)
+
+
+@pytest.mark.parametrize("normalize", [False, True])
+def test_chunk_matches_repeated_decode(device, normalize):
+    args = _decode_args(device, torch.float32, strided=True)
+    q, k, v = (args[name].transpose(0, 1) for name in ("q", "k", "v"))
+    a, b = args["a"].transpose(0, 1), args["b"].transpose(0, 1)
+    g = -args["A_log"].exp() * torch.nn.functional.softplus(a + args["dt_bias"])
+    beta = b.sigmoid()
+    pool = args["initial_state"]
+    before = pool.clone()
+    prefill_args = (q, k, v, g, beta, pool[:1], [0, 5])
+    chunk_out, chunk_state = _prefill(
+        prefill_args, device, normalize=normalize, final=True, scale=None
+    )
+    steps = []
+    for token in range(5):
+        steps.append(launch_gdn_decode_step(
+            q[:, token:token + 1], k[:, token:token + 1], v[:, token:token + 1],
+            A_log=args["A_log"],
+            a=a[:, token:token + 1],
+            dt_bias=args["dt_bias"],
+            b=b[:, token:token + 1],
+            initial_state=pool, initial_state_indices=torch.tensor([0], device=device),
+            output_state_indices=None, scale=None, use_qk_l2norm=normalize,
+        ))
+    _assert_close(torch.cat(steps, dim=1), chunk_out.cpu())
+    _assert_close(pool[:1], chunk_state.cpu())
+    torch.testing.assert_close(pool[1:], before[1:], rtol=0, atol=0)
+
+
+def test_decode_crossing_sources_are_snapshotted(device):
+    args = _decode_args(device, torch.float32, strided=False)
+    before = args["initial_state"].clone()
+    reads = torch.tensor([0, 1, -1, -1, -1], device=device)
+    # A separate destination map provides the expected outputs and states.
+    separate = before.clone()
+    expected = launch_gdn_decode_step(
+        **{**args, "initial_state": separate},
+        initial_state_indices=reads,
+        output_state_indices=torch.tensor([5, 6, -1, -1, -1], device=device),
+        scale=None, use_qk_l2norm=True,
+    )
+    out = launch_gdn_decode_step(
+        **args,
+        initial_state_indices=reads,
+        output_state_indices=torch.tensor([1, 0, -1, -1, -1], device=device),
+        scale=None, use_qk_l2norm=True,
+    )
+    torch.testing.assert_close(out, expected, rtol=0, atol=0)
+    torch.testing.assert_close(args["initial_state"][0], separate[6], rtol=0, atol=0)
+    torch.testing.assert_close(args["initial_state"][1], separate[5], rtol=0, atol=0)
+    torch.testing.assert_close(args["initial_state"][2:], before[2:], rtol=0, atol=0)
+
+
+def test_unbatched_and_empty_prefill(device):
+    args = _inputs([0, 0], torch.float32)
+    out, last = _prefill(args, device, normalize=True, final=True, scale=None)
+    assert out.shape == (1, 0, 4, 3)
+    torch.testing.assert_close(last.cpu(), args[5], rtol=0, atol=0)
+    q, k, v, g, beta, state, bounds = _inputs([4], torch.float32)
+    batched, batched_state = _prefill(
+        (q, k, v, g, beta, state, bounds), device,
+        normalize=True, final=True, scale=None,
+    )
+    unbatched, unbatched_state = _prefill(
+        (q[0], k[0], v[0], g[0], beta[0], state, bounds), device,
+        normalize=True, final=True, scale=None,
+    )
+    torch.testing.assert_close(unbatched, batched[0], rtol=0, atol=0)
+    torch.testing.assert_close(unbatched_state, batched_state, rtol=0, atol=0)
+
+
+def test_grouped_heads_match_explicit_expansion(device):
+    args = _inputs([2, 3], torch.float32)
+    out, state = _prefill(
+        args, device, normalize=True, final=True, scale=None
+    )
+    q, k, *rest = args
+    expanded = (
+        q.repeat_interleave(2, dim=-2),
+        k.repeat_interleave(2, dim=-2),
+        *rest,
+    )
+    explicit_out, explicit_state = _prefill(
+        expanded, device, normalize=True, final=True, scale=None
+    )
+    torch.testing.assert_close(out, explicit_out, rtol=0, atol=0)
+    torch.testing.assert_close(state, explicit_state, rtol=0, atol=0)
+
+
+def test_decode_all_padding_empty_pool(device):
+    args = _decode_args(device, torch.float32, strided=False)
+    args["initial_state"] = args["initial_state"][:0]
+    out = launch_gdn_decode_step(
+        **args,
+        initial_state_indices=torch.full((5,), -7, device=device),
+        output_state_indices=None, scale=None, use_qk_l2norm=True,
+    )
+    torch.testing.assert_close(out, torch.zeros_like(out), rtol=0, atol=0)
+
+
+@pytest.mark.parametrize(
+    "invalid",
+    [
+        "state_dtype", "grouping", "bounds", "checkpoint_counts",
+        "checkpoint_interval", "checkpoint_alias",
+    ],
+)
+def test_prefill_rejects_invalid_contracts(device, invalid):
+    q, k, v, g, beta, state, bounds = _inputs([65], torch.float32)
+    checkpoints = None
+    if invalid == "state_dtype":
+        state = state.bfloat16()
+    elif invalid == "grouping":
+        q, k = q[:, :, :1].expand(-1, -1, 3, -1), k[:, :, :1].expand(-1, -1, 3, -1)
+    elif invalid == "bounds":
+        bounds = [0, 64]
+    elif invalid == "checkpoint_counts":
+        checkpoints = (
+            64, torch.empty(1, 4, 3, 5, device=device),
+            torch.tensor([0, 0], dtype=torch.int32, device=device),
+        )
+    elif invalid == "checkpoint_interval":
+        checkpoints = (
+            63, torch.empty(1, 4, 3, 5, device=device),
+            torch.tensor([0, 1], dtype=torch.int32, device=device),
+        )
+    elif invalid == "checkpoint_alias":
+        state = state.to(device)
+        checkpoints = (64, state, torch.tensor([0, 1], dtype=torch.int32, device=device))
+    with pytest.raises(ValueError):
+        _prefill(
+            (q, k, v, g, beta, state, bounds), device,
+            normalize=True, final=True, scale=None, checkpoints=checkpoints,
+        )
+
+
+@pytest.mark.parametrize(
+    "invalid",
+    ["state_dtype", "index_range", "duplicate_destinations", "index_dtype", "mtp"],
+)
+def test_decode_rejects_invalid_contracts_without_writes(device, invalid):
+    args = _decode_args(device, torch.float32, strided=False)
+    reads = torch.tensor([0, 1, 2, 3, 4], device=device)
+    writes = None
+    if invalid == "state_dtype":
+        args["initial_state"] = args["initial_state"].bfloat16()
+    elif invalid == "index_range":
+        reads[0] = 9
+    elif invalid == "duplicate_destinations":
+        writes = torch.tensor([5, 5, 6, 7, 8], device=device)
+    elif invalid == "index_dtype":
+        reads = reads.float()
+    elif invalid == "mtp":
+        args.update({name: args[name].expand(-1, 2, -1, -1) for name in ("q", "k", "v")})
+    before = args["initial_state"].clone()
+    with pytest.raises(ValueError):
+        launch_gdn_decode_step(
+            **args, initial_state_indices=reads, output_state_indices=writes,
+            scale=None, use_qk_l2norm=True,
+        )
+    torch.testing.assert_close(args["initial_state"], before, rtol=0, atol=0)
+
+
+def test_public_registry_npu():
+    pytest.importorskip("torch_npu")
+    if not torch.npu.is_available():
+        pytest.skip("Ascend NPU required")
+    from tokenspeed_kernel.ops.attention.gdn import (
+        GdnCheckpointLayout,
+        GdnStateCheckpoints,
+        gdn_chunk_prefill,
+        gdn_chunk_prefill_capturable,
+        gdn_chunk_prefill_stores_state_checkpoints,
+        gdn_decode_step,
+    )
+    from tokenspeed_kernel.selection import NoKernelFoundError
+
+    args = _inputs([65, 1], torch.bfloat16)
+    q, k, v, g, beta, state, bounds = args
+    expected, expected_state, history = _reference(
+        q, k, v, g, beta, state, bounds,
+        scale=0.37, normalize=True, round_normalized=True,
+    )
+    checkpoints = torch.empty(1, 4, 3, 5, device="npu")
+    kwargs = dict(
+        scale=0.37,
+        initial_state=state.npu(),
+        cu_seqlens=torch.tensor(bounds, dtype=torch.int32, device="npu"),
+        qk_l2norm=True,
+        output_final_state=True,
+        output_h=False,
+        solution="ascend",
+    )
+    result = gdn_chunk_prefill(
+        q.npu(), k.npu(), v.npu(), g.npu(), beta.npu(), **kwargs,
+        state_checkpoints=GdnStateCheckpoints(
+            64, checkpoints,
+            torch.tensor([0, 1, 1], dtype=torch.int32, device="npu"),
+        ),
+    )
+    _assert_close(result.out, expected)
+    _assert_close(result.final_state, expected_state)
+    _assert_close(checkpoints, history[0][63].unsqueeze(0))
+    assert result.h is None and result.h_cu_starts is None
+    assert result.h_layout == GdnCheckpointLayout.NONE
+    geometry = dict(
+        head_dim=5, value_head_dim=3, num_q_heads=2,
+        num_v_heads=4, qk_l2norm=True,
+    )
+    assert not gdn_chunk_prefill_capturable(torch.bfloat16, **geometry)
+    assert gdn_chunk_prefill_stores_state_checkpoints(
+        torch.bfloat16, **geometry, interval_granularity=64
+    )
+    with pytest.raises(NoKernelFoundError):
+        gdn_chunk_prefill(
+            q.npu(), k.npu(), v.npu(), g.npu(), beta.npu(),
+            **{**kwargs, "output_h": True},
+        )
+    with pytest.raises(ValueError, match="output_h"):
+        gdn_chunk_prefill(
+            q.npu(), k.npu(), v.npu(), g.npu(), beta.npu(),
+            **{**kwargs, "output_h": True}, override="ascend_gdn_chunk_prefill",
+        )
+
+    decode = _decode_args("npu", torch.bfloat16, strided=True)
+    read = torch.tensor([0, 1, -1, 2, 3], device="npu")
+    write = torch.tensor([5, 6, -1, 7, 8], device="npu")
+    before = decode["initial_state"].clone()
+    expected_pool = before.clone()
+    expected_out = launch_gdn_decode_step(
+        **{**decode, "initial_state": expected_pool},
+        initial_state_indices=read, output_state_indices=write,
+        scale=None, use_qk_l2norm=False,
+    )
+    public_out = gdn_decode_step(
+        **decode, initial_state_indices=read, output_state_indices=write,
+        scale=None, use_qk_l2norm=False, solution="ascend",
+    )
+    torch.testing.assert_close(public_out, expected_out, rtol=0, atol=0)
+    torch.testing.assert_close(decode["initial_state"], expected_pool, rtol=0, atol=0)
