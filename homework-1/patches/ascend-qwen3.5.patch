+    capture_lengths = _metadata([1, 1])
+
+    def decode():
+        return module.mha_decode_with_kvcache(
+            q, k, v, table, capture_lengths, 256, max_seqlen_q=1, **dispatch
+        )
+
+    for _ in range(3):
