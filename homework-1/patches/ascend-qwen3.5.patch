+"""Eager GDN scans using device-local FP32 PyTorch arithmetic.
+
+Only integer routing metadata is synchronized to Python. No activation or state
+is moved off device. CPU inputs are accepted for direct unit testing, not as an
+accelerator fallback. Registry adapters require NPU inputs. See docs/gdn.md.
+"""
+
+from __future__ import annotations
+
+import torch
+import torch.nn.functional as F
+
+
+_FLOAT_DTYPES = (torch.float16, torch.bfloat16, torch.float32)
+
+
+def _same_device(device: torch.device, **tensors: torch.Tensor) -> None:
+    for name, tensor in tensors.items():
+        if tensor.device != device:
+            raise ValueError(f"{name} must be on {device}, got {tensor.device}")
+        if not tensor.is_floating_point():
+            raise ValueError(f"{name} must be floating point")
+
+
+def _metadata(tensor: torch.Tensor, name: str, size: int) -> list[int]:
+    if tensor.shape != (size,) or tensor.dtype not in (torch.int32, torch.int64):
+        raise ValueError(f"{name} must be an int32/int64 vector of length {size}")
+    # Intentional eager synchronization of metadata only, never activations.
+    return tensor.tolist()
+
+
+def _geometry(
+    q: torch.Tensor, k: torch.Tensor, v: torch.Tensor
+) -> tuple[int, int, int]:
+    if q.ndim != 4 or k.shape != q.shape or v.ndim != 4:
+        raise ValueError(
+            "q/k must have equal [B,T,H,K] shapes; v must be [B,T,HV,V]"
+        )
+    if v.shape[:2] != q.shape[:2]:
+        raise ValueError("q/k/v must have matching batch and token dimensions")
+    h, dim = q.shape[-2:]
+    hv, vdim = v.shape[-2:]
+    if min(h, hv, dim, vdim) <= 0 or hv < h or hv % h:
+        raise ValueError(
+            "GDN requires positive head dimensions and HV a multiple of H"
+        )
+    if q.dtype not in _FLOAT_DTYPES or k.dtype != q.dtype or v.dtype != q.dtype:
+        raise ValueError("q/k/v must share float16, bfloat16 or float32 dtype")
+    _same_device(q.device, k=k, v=v)
+    return hv, vdim, dim
+
+
+def _state(
+    state: torch.Tensor, shape: tuple[int, ...], device: torch.device
+) -> None:
+    if (
+        state.shape != shape
+        or state.dtype != torch.float32
+        or state.device != device
+    ):
+        raise ValueError(f"state must be float32 K-last {shape} on {device}")
+
+
+def _qk(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    hv: int,
+    *,
+    normalize: bool,
+    round_normalized: bool,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    qf, kf = q.float(), k.float()
+    if normalize:
+        # Upstream l2norm and fused decode both add 1e-6 *inside* sqrt.
+        qf = qf * torch.rsqrt(qf.square().sum(-1, keepdim=True) + 1e-6)
+        kf = kf * torch.rsqrt(kf.square().sum(-1, keepdim=True) + 1e-6)
+        if round_normalized:
+            # Chunk prefill materializes l2norm in the input dtype; decode does not.
+            qf, kf = qf.to(q.dtype).float(), kf.to(k.dtype).float()
+    group = hv // q.shape[-2]
+    return qf.repeat_interleave(group, dim=-2), kf.repeat_interleave(group, dim=-2)
+
+
+def _step(
+    state: torch.Tensor,
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    scale: float,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    decayed = state * g.float().exp()[..., None, None]
+    residual = (
+        v.float() - (decayed * k[..., None, :]).sum(-1)
+    ) * beta.float()[..., None]
+    updated = decayed + residual[..., :, None] * k[..., None, :]
+    out = (updated * (q * scale)[..., None, :]).sum(-1)
+    return out, updated
+
+
+@torch.no_grad()
+def launch_gdn_chunk_prefill(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    *,
+    scale: float | None,
+    initial_state: torch.Tensor,
+    cu_seqlens: torch.Tensor,
+    qk_l2norm: bool,
+    output_final_state: bool,
+    checkpoint_every_n_tokens: int | None,
+    checkpoint_states: torch.Tensor | None,
+    checkpoint_cu_starts: torch.Tensor | None,
+) -> tuple[torch.Tensor, torch.Tensor | None]:
+    """Scan packed variable-length sequences, without mutating initial_state.
+
+    Args:
+        q, k: [1,T,H,K], or unbatched [T,H,K], same floating dtype as v.
+        v: [1,T,HV,V] (or [T,HV,V]); HV is an integer multiple of H.
+        g, beta: Log forget and update gates [1,T,HV] (or [T,HV]).
+        scale: Query scale; None means K**-0.5.
+        initial_state: FP32 K-last [N,HV,V,K], including nonzero prefixes.
+        cu_seqlens: Integer [N+1] packed token offsets, including empty sequences.
+        qk_l2norm: Normalize with epsilon 1e-6, rounding to input dtype.
+        output_final_state: Whether to return FP32 [N,HV,V,K] final states.
+        checkpoint_every_n_tokens: Positive multiple of 64, or None (disabled).
+        checkpoint_states: Caller-owned FP32 [total,HV,V,K] checkpoint destination.
+        checkpoint_cu_starts: Int32 [N+1] cumulative checkpoint counts on device.
+            All three checkpoint arguments must be supplied together or be None.
+
+    Returns:
+        (out in q.dtype and v.shape, optional final state). Checkpoints contain
+        the state after each whole interval of each sequence's own tokens.
+        All tensor math stays on the input device; metadata uses .tolist().
+    """
+    unbatched = q.ndim == 3
+    if unbatched:
+        q, k, v = q.unsqueeze(0), k.unsqueeze(0), v.unsqueeze(0)
+        g, beta = g.unsqueeze(0), beta.unsqueeze(0)
+    hv, vdim, dim = _geometry(q, k, v)
+    if q.shape[0] != 1:
+        raise ValueError("prefill requires packed batch dimension 1")
+    tokens = q.shape[1]
+    if g.shape != (1, tokens, hv) or beta.shape != g.shape:
+        raise ValueError("prefill g/beta must have shape [1,T,HV]")
+    _same_device(q.device, g=g, beta=beta)
+    if cu_seqlens.ndim != 1 or cu_seqlens.numel() < 1:
+        raise ValueError("cu_seqlens must have N+1 entries")
+    n = cu_seqlens.numel() - 1
+    bounds = _metadata(cu_seqlens, "cu_seqlens", n + 1)
+    if (
+        bounds[0] != 0
+        or bounds[-1] != tokens
+        or any(a > b for a, b in zip(bounds, bounds[1:]))
+    ):
+        raise ValueError("cu_seqlens must be monotone and cover exactly T tokens")
+    _state(initial_state, (n, hv, vdim, dim), q.device)
+
+    starts = None
+    checkpoint_args = (
+        checkpoint_every_n_tokens,
+        checkpoint_states,
+        checkpoint_cu_starts,
+    )
+    if any(arg is not None for arg in checkpoint_args):
+        if any(arg is None for arg in checkpoint_args):
+            raise ValueError("all checkpoint arguments must be supplied together")
+        if checkpoint_every_n_tokens <= 0 or checkpoint_every_n_tokens % 64:
+            raise ValueError("checkpoint interval must be a positive multiple of 64")
+        if (
+            checkpoint_cu_starts.device != q.device
+            or checkpoint_cu_starts.dtype != torch.int32
+        ):
+            raise ValueError("checkpoint_cu_starts must be int32 on the input device")
+        starts = _metadata(checkpoint_cu_starts, "checkpoint_cu_starts", n + 1)
+        expected = [0]
+        for begin, end in zip(bounds, bounds[1:]):
+            expected.append(
+                expected[-1] + (end - begin) // checkpoint_every_n_tokens
+            )
+        if starts != expected:
+            raise ValueError(
+                "checkpoint_cu_starts must match per-sequence interval counts"
+            )
+        _state(checkpoint_states, (starts[-1], hv, vdim, dim), q.device)
+        # Caller-owned destinations must not alias the immutable input state.
+        if (
+            checkpoint_states.numel()
+            and checkpoint_states.untyped_storage().data_ptr()
+            == initial_state.untyped_storage().data_ptr()
+        ):
+            raise ValueError("checkpoint_states must not alias initial_state")
+
+    qf, kf = _qk(q[0], k[0], hv, normalize=qk_l2norm, round_normalized=True)
+    out = torch.empty(v.shape, dtype=q.dtype, device=q.device)
+    final = torch.empty_like(initial_state) if output_final_state else None
+    scale = dim**-0.5 if scale is None else scale
+    for seq, (begin, end) in enumerate(zip(bounds, bounds[1:])):
+        state = initial_state[seq].clone()
+        for token in range(begin, end):
+            value, state = _step(
+                state,
+                qf[token],
+                kf[token],
+                v[0, token],
+                g[0, token],
+                beta[0, token],
+                scale,
+            )
+            out[0, token].copy_(value)
+            consumed = token - begin + 1
+            if starts is not None and consumed % checkpoint_every_n_tokens == 0:
+                checkpoint_row = (
+                    starts[seq] + consumed // checkpoint_every_n_tokens - 1
+                )
+                checkpoint_states[checkpoint_row].copy_(state)
+        if final is not None:
+            final[seq].copy_(state)
+    return (out[0] if unbatched else out), final
+
+
+@torch.no_grad()
+def launch_gdn_decode_step(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    *,
+    A_log: torch.Tensor,
+    a: torch.Tensor,
+    dt_bias: torch.Tensor,
+    b: torch.Tensor,
+    initial_state: torch.Tensor,
+    initial_state_indices: torch.Tensor,
+    scale: float | None,
+    output_state_indices: torch.Tensor | None,
+    use_qk_l2norm: bool,
+) -> torch.Tensor:
+    """Compute T=1 decode and write only valid destination rows of the FP32 pool.
+
+    Args:
+        q, k: [B,1,H,K], same floating dtype as v; arbitrary strides supported.
+        v: [B,1,HV,V], HV an integer multiple of H.
+        A_log, dt_bias: Floating [HV] decay parameters, converted on device to FP32.
+        a, b: Floating [B,1,HV] decay and beta logits.
+        initial_state: FP32 K-last [pool,HV,V,K], updated at destination rows.
+        initial_state_indices: Integer [B] read rows; negative means padding.
+        scale: Query scale, None means K**-0.5.
+        output_state_indices: Integer [B] destinations; None writes to read rows.
+            A negative destination suppresses the write. Padding reads never write.
+            Active destinations must be unique; shared input rows are allowed.
+        use_qk_l2norm: Normalize Q/K in FP32 with epsilon 1e-6.
+
+    Returns:
+        [B,1,HV,V] in q.dtype. Padding reads produce zero output. All sources
+        are snapshotted before any writes, including crossing read/write maps.
+        Only routing metadata is synchronized to Python; no CPU math fallback.
+    """
+    hv, vdim, dim = _geometry(q, k, v)
+    batch, tokens = q.shape[:2]
+    if tokens != 1:
+        raise ValueError("GDN decode_step supports T=1 only (no speculative MTP)")
+    if a.shape != (batch, 1, hv) or b.shape != a.shape:
+        raise ValueError("decode a/b must have shape [B,1,HV]")
+    if A_log.shape != (hv,) or dt_bias.shape != (hv,):
+        raise ValueError("A_log/dt_bias must have shape [HV]")
+    _same_device(q.device, A_log=A_log, a=a, dt_bias=dt_bias, b=b)
+    if initial_state.ndim != 4:
+        raise ValueError("initial_state must be a K-last pool [pool,HV,V,K]")
+    pool = initial_state.shape[0]
+    _state(initial_state, (pool, hv, vdim, dim), q.device)
+    reads = _metadata(initial_state_indices, "initial_state_indices", batch)
+    writes = (
+        reads
+        if output_state_indices is None
+        else _metadata(output_state_indices, "output_state_indices", batch)
+    )
+    if any(idx >= pool for idx in reads + writes):
+        raise ValueError("state index is outside the pool")
+    destinations = [
+        dst for src, dst in zip(reads, writes) if src >= 0 and dst >= 0
+    ]
+    if len(destinations) != len(set(destinations)):
+        raise ValueError("active output_state_indices must be unique")
+
+    # Snapshot all requests first: a destination may be another request's source.
+    states = [initial_state[src].clone() if src >= 0 else None for src in reads]
+    qf, kf = _qk(
+        q[:, 0], k[:, 0], hv,
+        normalize=use_qk_l2norm, round_normalized=False,
+    )
+    gates = -A_log.float().exp() * F.softplus(
+        a[:, 0].float() + dt_bias.float(), beta=1.0, threshold=20.0
+    )
+    betas = b[:, 0].float().sigmoid()
+    out = torch.zeros(v.shape, dtype=q.dtype, device=q.device)
+    scale = dim**-0.5 if scale is None else scale
+    for row, state in enumerate(states):
+        if state is None:
+            continue
+        value, updated = _step(
+            state, qf[row], kf[row], v[row, 0], gates[row], betas[row], scale
+        )
+        out[row, 0].copy_(value)
+        if writes[row] >= 0:
+            initial_state[writes[row]].copy_(updated)
+    return out
