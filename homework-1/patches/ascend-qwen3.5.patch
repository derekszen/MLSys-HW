+        eps=1e-6, group_size=3, norm_before_gate=True, sigmoid_gate=False,
+        fp8_scale=None, weights_independent=True,
+    )
+    args[name] = args[name].to("meta")
+    with pytest.raises(ValueError, match="same device"):
+        launch_gated_rmsnorm(**args)
+
+
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16, torch.float32])
+@pytest.mark.parametrize("group_size,shared", [(None, False), (128, True)])
+@pytest.mark.parametrize("norm_before_gate", [False, True])
+@pytest.mark.parametrize("sigmoid_gate", [False, True])
+def test_public_dispatch_npu(dtype, group_size, shared, norm_before_gate, sigmoid_gate):
