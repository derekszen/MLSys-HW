+        ({"x": torch.ones(2, 12, dtype=torch.int32)}, ValueError, "x must be"),
+        ({"weight": torch.ones(12, dtype=torch.int32)}, ValueError, "weight must be"),
+        ({"z": torch.ones(2, 12, dtype=torch.int32)}, ValueError, "z must be"),
+        ({"fp8_scale": torch.tensor([0.1])}, NotImplementedError, "FP8 output"),
+    ],
+)
+def test_rejects_unsupported_inputs(device, change, error, match):
