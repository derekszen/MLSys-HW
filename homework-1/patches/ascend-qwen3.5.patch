+def _strided(tensor, *, projection):
+    width = tensor.shape[-1]
+    storage = torch.empty(
+        (*tensor.shape[:-1], 3 * width), dtype=tensor.dtype, device=tensor.device
+    )
+    view = storage[..., width : 2 * width] if projection else storage[..., ::3]
+    view.copy_(tensor)
+    return view
+
