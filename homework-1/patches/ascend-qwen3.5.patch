+"""Real Ascend MHA against an independent CPU FP64 attention oracle."""
+
+import itertools
+import math
+
+import pytest
+import torch
+
+try:
+    import torch_npu  # noqa: F401
+except ModuleNotFoundError as exc:
+    if exc.name != "torch_npu":
+        raise
+    pytest.skip("torch_npu is not installed", allow_module_level=True)
+
+from tokenspeed_kernel_npu.ops import mha as native_mha
+
+
+@pytest.fixture(autouse=True)
+def require_npu():
+    # An installed but broken Ascend stack must fail, not silently skip.
+    assert torch.npu.is_available(), "These tests require a visible Ascend NPU"
+
+
+@pytest.fixture(params=["native", "registry"])
+def ops(request):
+    if request.param == "native":
+        return native_mha, {}
+    from tokenspeed_kernel.ops.attention import mha
+
+    return mha, {"solution": "torch_npu"}
+
+
+def _offsets(lengths):
+    return list(itertools.accumulate(lengths, initial=0))
+
+
+def _metadata(values):
+    return torch.tensor(values, dtype=torch.int32, device="npu")
+
+
+def _randn(shape, dtype, generator):
+    return torch.randn(shape, generator=generator).to(dtype)
+
+
+def _reference(q, k, v, *, causal, scale):
+    """CPU-only FP64 GQA, including bottom-right causal suffix alignment."""
+    assert q.device.type == k.device.type == v.device.type == "cpu"
+    if not q.shape[0]:
+        return q.double()
+    groups = q.shape[1] // k.shape[1]
+    keys = k.double().repeat_interleave(groups, dim=1)
+    values = v.double().repeat_interleave(groups, dim=1)
+    logits = q.double().transpose(0, 1) @ keys.permute(1, 2, 0) * scale
+    if causal:
+        last_visible = k.shape[0] - q.shape[0] + torch.arange(q.shape[0])
+        mask = torch.arange(k.shape[0])[None, :] > last_visible[:, None]
+        logits.masked_fill_(mask[None, :, :], -math.inf)
+    probabilities = torch.softmax(logits, dim=-1)
+    return (probabilities @ values.transpose(0, 1)).transpose(0, 1)
+
+
+def _assert_result(actual, expected, query):
+    assert actual.shape == query.shape
+    assert actual.dtype == query.dtype
+    assert actual.device == query.device
+    atol, rtol = (3e-3, 8e-3) if query.dtype == torch.bfloat16 else (4e-4, 1e-3)
+    torch.testing.assert_close(actual.cpu().double(), expected, atol=atol, rtol=rtol)
+
+
+def _paged_case(q_lengths, kv_lengths, *, dtype, head_dim, page_size):
+    generator = torch.Generator().manual_seed(256)
+    width = max(1, math.ceil(max(kv_lengths, default=0) / page_size))
+    pages = len(q_lengths) * width + 2
+    # Unique shuffled physical pages, with spare pages never referenced.
+    table = torch.randperm(pages - 2, generator=generator).reshape(-1, width)
+    q = _randn((sum(q_lengths), 8, head_dim), dtype, generator)
+    k = _randn((pages, page_size, 2, head_dim), dtype, generator)
+    v = _randn(k.shape, dtype, generator)
+    return q, k, v, table.to(torch.int32)
+
+
+def _paged_reference(q, k, v, table, q_lengths, kv_lengths, *, causal, scale):
+    pieces = []
+    offsets = _offsets(q_lengths)
+    for batch, (start, end) in enumerate(zip(offsets[:-1], offsets[1:])):
+        length = kv_lengths[batch]
+        keys = k[table[batch].long()].flatten(0, 1)[:length]
+        values = v[table[batch].long()].flatten(0, 1)[:length]
+        pieces.append(
+            _reference(q[start:end], keys, values, causal=causal, scale=scale)
+        )
+    return torch.cat(pieces) if pieces else q.double()
+
+
+def _extend(module, dispatch, q, k, v, table, q_lengths, kv_lengths, *, causal, scale):
+    return module.mha_extend_with_kvcache(
+        q=q,
+        cu_seqlens_q=_metadata(_offsets(q_lengths)),
+        cu_seqlens_kv=_metadata(_offsets(kv_lengths)),
+        k_cache=k,
+        v_cache=v,
+        page_table=table,
+        cache_seqlens=_metadata(kv_lengths),
+        max_seqlen_q=max(q_lengths, default=0),
+        max_seqlen_k=max(kv_lengths, default=0),
+        is_causal=causal,
+        softmax_scale=scale,
+        **dispatch,
+    )
+
+
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float16])
+@pytest.mark.parametrize("scale", [None, 0.125, 0.0])
+@pytest.mark.parametrize(
+    "lengths", [[], [0], [0, 0, 0], [0, 1, 5, 0, 3, 0], [3, 129, 7]]
+)
+def test_packed_prefill(ops, dtype, scale, lengths):
+    module, dispatch = ops
+    offsets = _offsets(lengths)
+    generator = torch.Generator().manual_seed(91)
+    host_q = _randn((sum(lengths), 8, 256), dtype, generator)
+    host_k = _randn((sum(lengths), 2, 256), dtype, generator)
+    host_v = _randn(host_k.shape, dtype, generator)
+    q, k, v = (tensor.to("npu") for tensor in (host_q, host_k, host_v))
+    saved = [tensor.clone() for tensor in (q, k, v)]
+    output = module.mha_prefill(
+        q,
+        k,
+        v,
+        _metadata(offsets),
+        offsets,
+        max(lengths, default=0),
+        softmax_scale=scale,
+        **dispatch,
+    )
+    pieces = [
+        _reference(
+            host_q[start:end],
+            host_k[start:end],
+            host_v[start:end],
+            causal=True,
+            scale=1 / 16 if scale is None else scale,
+        )
+        for start, end in zip(offsets[:-1], offsets[1:])
+    ]
+    _assert_result(output, torch.cat(pieces) if pieces else host_q.double(), q)
+    for tensor, original in zip((q, k, v), saved):
+        torch.testing.assert_close(tensor, original, atol=0, rtol=0)
