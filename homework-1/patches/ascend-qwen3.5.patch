+"""Independent numerical CPU/NPU tests of the actual eager implementation.
+
+Run -k cpu without torch_npu; -k npu exercises a real Ascend device, including
+public registry dispatch. No mocks or tokenspeed-kernel imports in CPU tests.
+"""
+
+import pytest
+import torch
+import torch.nn.functional as F
+from tokenspeed_kernel_npu.ops.conv import (
+    launch_causal_conv1d_prefill,
+    launch_causal_conv1d_update,
+)
+
+
+@pytest.fixture(params=["cpu", "npu"])
+def device(request):
+    if request.param == "npu":
+        pytest.importorskip("torch_npu")
+        if not torch.npu.is_available():
+            pytest.skip("Ascend NPU required")
+    return request.param
+
+
+def _random(shape, dtype, *, seed):
+    return (torch.randn(shape, generator=torch.Generator().manual_seed(seed)) * 0.4).to(dtype)
+
+
+def _strided(tensor):
+    storage = torch.full(
+        (*tensor.shape[:-1], tensor.shape[-1] * 2),
+        -91, dtype=tensor.dtype, device=tensor.device,
+    )
+    view = storage[..., ::2]
+    view.copy_(tensor)
+    return view, storage
+
+
+def _state(pool, device, *, width_major, strided):
+    result = pool.transpose(1, 2) if width_major else pool
+    result = result.to(device).clone()
+    if strided:
+        return _strided(result)
+    return result, None
+
+
+def _canonical(state, *, width_major):
+    return state.transpose(1, 2) if width_major else state
+
+
+def _schedule(bounds, device, *, inactive=0):
+    batches, chunks = [], []
+    for seq, (begin, end) in enumerate(zip(bounds, bounds[1:])):
+        for chunk in range((end - begin + 7) // 8):
+            batches.append(seq)
+            chunks.append(chunk)
+    batches.extend([-1] * inactive)
+    chunks.extend([0] * inactive)
+    return dict(
+        batch_indices=torch.tensor(batches, dtype=torch.int32, device=device),
+        chunk_offsets=torch.tensor(chunks, dtype=torch.int32, device=device),
+        block_m=8,
+        cu_seqlens_cpu=torch.tensor(bounds, dtype=torch.int64),
+    )
+
+
+def _prefill(x, weight, bias, state, bounds, *, indices=None, initial=None, activation):
+    return launch_causal_conv1d_prefill(
+        x, weight, bias, state,
+        torch.tensor(bounds, dtype=torch.int32, device=x.device),
+        cache_indices=indices,
+        has_initial_state=initial,
+        activation=activation,
+        validate_data=True,
+        **_schedule(bounds, x.device, inactive=2),
+    )
+
+
+def _reference(sequence, history, weight, bias, activation):
+    """Independent CPU float64 grouped convolution (implementation uses taps)."""
+    joined = torch.cat((history.double(), sequence.double()), dim=1)
+    if sequence.shape[1] == 0:
+        return sequence.clone(), history.clone()
+    result = F.conv1d(
+        joined[None], weight.double()[:, None],
+        bias=None if bias is None else bias.double(), groups=sequence.shape[0],
+    )[0]
+    if activation is True or activation in ("silu", "swish"):
+        result = result * torch.sigmoid(result)
+    return result.to(sequence.dtype), joined[:, -history.shape[1]:].to(history.dtype)
+
+
+def _close(actual, expected):
+    if actual.dtype == torch.bfloat16:
+        rtol, atol = 8e-3, 5e-4
+    elif actual.dtype == torch.float16:
+        rtol, atol = 1e-3, 5e-5
+    else:
+        rtol, atol = 2e-5, 2e-7
+    torch.testing.assert_close(actual.cpu(), expected.cpu(), rtol=rtol, atol=atol)
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.float16, torch.bfloat16])
+@pytest.mark.parametrize("width", [2, 3, 4, 5])
+@pytest.mark.parametrize("width_major", [False, True])
+@pytest.mark.parametrize("activation", [None, "silu", "swish", True, False])
+def test_prefill_history_reset_padding_and_strides(device, dtype, width, width_major, activation):
+    channels, bounds = 6, [0, 1, 1, 3, 14]
+    # Two unassigned tail tokens model eager storage-capacity padding.
+    x_cpu = _random((channels, 16), dtype, seed=13)
+    weight_cpu = _random((channels, width), dtype, seed=17)
+    bias_cpu = _random((channels,), dtype, seed=19)
+    pool = _random((5, channels, width - 1), dtype, seed=23)
+    x, x_storage = _strided(x_cpu.to(device))
+    weight, _ = _strided(weight_cpu.to(device))
+    bias, _ = _strided(bias_cpu.to(device))
+    state, state_storage = _state(pool, device, width_major=width_major, strided=True)
+    expected = torch.zeros_like(x_cpu)
+    expected_pool = pool.clone()
+    slots, flags = [3, 0, -7, 1], [True, False, True, False]
+    for i, (begin, end) in enumerate(zip(bounds, bounds[1:])):
+        if slots[i] < 0 or begin == end:
+            continue
+        history = pool[slots[i]] if flags[i] else torch.zeros_like(pool[slots[i]])
+        expected[:, begin:end], expected_pool[slots[i]] = _reference(
+            x_cpu[:, begin:end], history, weight_cpu, bias_cpu, activation,
+        )
+    out = _prefill(
+        x, weight, bias, state, bounds,
+        indices=torch.tensor(slots, dtype=torch.int32, device=device),
+        initial=torch.tensor(flags, dtype=torch.bool, device=device), activation=activation,
+    )
+    assert out.dtype == dtype and out.device == x.device
+    _close(out, expected)
+    torch.testing.assert_close(x.cpu(), x_cpu, rtol=0, atol=0)
+    torch.testing.assert_close(
+        _canonical(state, width_major=width_major).cpu(), expected_pool, rtol=0, atol=0,
+    )
+    # Guard channels outside strided views must never be overwritten.
+    assert torch.all(x_storage[..., 1::2] == -91).item()
+    assert torch.all(state_storage[..., 1::2] == -91).item()
+    out.zero_()
+    torch.testing.assert_close(x.cpu(), x_cpu, rtol=0, atol=0)
+
+
+@pytest.mark.parametrize("dtype", [torch.float32, torch.float16, torch.bfloat16])
+@pytest.mark.parametrize("width_major", [False, True])
+@pytest.mark.parametrize("bias_enabled", [False, True])
+def test_full_chunk_and_one_step_parity(device, dtype, width_major, bias_enabled):
+    channels, width, batch, length = 6, 4, 3, 11
+    data = _random((batch, channels, length), dtype, seed=31)
+    weight_cpu = _random((channels, width), dtype, seed=37)
+    bias_cpu = _random((channels,), dtype, seed=41) if bias_enabled else None
+    pool = _random((5, channels, width - 1), dtype, seed=43)
+    slots, flags = [2, 0, 4], [True, False, True]
+    indices = torch.tensor(slots, dtype=torch.int64, device=device)
+    initial = torch.tensor(flags, dtype=torch.bool, device=device)
+    weight, bias = weight_cpu.to(device), None if bias_cpu is None else bias_cpu.to(device)
+    full_state, _ = _state(pool, device, width_major=width_major, strided=False)
+    packed = torch.cat(list(data), dim=1).to(device)
+    full = _prefill(
+        packed, weight, bias, full_state, [0, 11, 22, 33],
+        indices=indices, initial=initial, activation="silu",
+    )
+    references = []
+    expected_pool = pool.clone()
+    for i, slot in enumerate(slots):
+        history = pool[slot] if flags[i] else torch.zeros_like(pool[slot])
+        values, expected_pool[slot] = _reference(data[i], history, weight_cpu, bias_cpu, "silu")
+        references.append(values)
+    _close(full, torch.cat(references, dim=1))
+    torch.testing.assert_close(
+        _canonical(full_state, width_major=width_major).cpu(), expected_pool,
+        rtol=0, atol=0,
+    )
+
+    chunk_state, _ = _state(pool, device, width_major=width_major, strided=True)
+    pieces = [[] for _ in range(batch)]
+    start = 0
+    for chunk_length in (1, 2, 0, 3, 5):
+        chunk = torch.cat(list(data[:, :, start:start + chunk_length]), dim=1).to(device)
+        out = _prefill(
+            chunk, weight, bias, chunk_state,
+            [i * chunk_length for i in range(batch + 1)],
+            indices=indices,
+            initial=initial if start == 0 else torch.ones_like(initial), activation="silu",
+        )
+        for i in range(batch):
+            pieces[i].append(out[:, i * chunk_length:(i + 1) * chunk_length])
+        start += chunk_length
+    chunked = torch.cat([torch.cat(seq, dim=1) for seq in pieces], dim=1)
+    _close(chunked, full)
+    torch.testing.assert_close(chunk_state, full_state, rtol=0, atol=0)
+
+    decode_pool = pool.clone()
+    decode_pool[slots[1]].zero_()  # Greedy update always consumes its source window.
+    decode_state, _ = _state(decode_pool, device, width_major=width_major, strided=True)
+    outputs = []
+    for token in range(length):
+        x, _ = _strided(data[:, :, token].to(device))
+        out = launch_causal_conv1d_update(
+            x, decode_state, weight, bias, "silu",
+            conv_state_indices=indices, parent_indices=None, validate_data=True,
+        )
+        assert out is x
+        outputs.append(out.clone())
+    decoded = torch.stack(outputs, dim=-1)
+    _close(torch.cat(list(decoded), dim=1), full)
+    torch.testing.assert_close(decode_state, full_state, rtol=0, atol=0)
+
+
+@pytest.mark.parametrize("width_major", [False, True])
+@pytest.mark.parametrize("rank_three", [False, True])
+@pytest.mark.parametrize("dtype", [torch.float32, torch.float16, torch.bfloat16])
+@pytest.mark.parametrize("width", [2, 3, 4, 5])
+def test_update_crossing_maps_shared_sources_padding_and_strides(
+    device, width_major, rank_three, dtype, width,
+):
+    channels = 6
+    raw = _random((6, channels, 1), dtype, seed=47)
+    pool = _random((6, channels, width - 1), dtype, seed=53)
+    weight_cpu = _random((channels, width), dtype, seed=59)
+    bias_cpu = _random((channels,), dtype, seed=61)
+    sources, destinations = [1, 0, 1, -1, -7, 2], [0, 1, 3, 4, -1, -9]
+    expected = raw.clone()
+    final_pool = pool.clone()
+    for i, source in enumerate(sources):
+        if source < 0:
+            continue
+        expected[i], final = _reference(raw[i], pool[source], weight_cpu, bias_cpu, "swish")
+        if destinations[i] >= 0:
+            final_pool[destinations[i]] = final
+    x, x_storage = _strided((raw if rank_three else raw[:, :, 0]).to(device))
+    state, guard = _state(pool, device, width_major=width_major, strided=True)
+    weight, _ = _strided(weight_cpu.to(device))
+    bias, _ = _strided(bias_cpu.to(device))
+    source_indices, _ = _strided(torch.tensor(sources, dtype=torch.int32, device=device))
+    output_indices, _ = _strided(
+        torch.tensor(destinations, dtype=torch.int32, device=device)[:, None]
+    )
+    result = launch_causal_conv1d_update(
