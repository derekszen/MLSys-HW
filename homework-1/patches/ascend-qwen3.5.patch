+def test_strides_and_mixed_dtypes(device, projection, norm_before_gate, dtype):
+    x, weight, z = _inputs((2, 3, 12), dtype, shared=True, group_size=3)
+    # Independently typed gate and weight are widened, never rounded to x's dtype.
+    weight, z = weight.float() + 0.00031, z.float() + 0.00027
+    args = (
+        _strided(x.to(device), projection=projection).transpose(0, 1),
+        _strided(weight.to(device), projection=False),
+        _strided(z.to(device), projection=projection).transpose(0, 1),
+    )
+    kwargs = dict(
+        eps=1e-6, group_size=3,
+        norm_before_gate=norm_before_gate, sigmoid_gate=False,
+    )
+    expected = _reference(*(t.cpu() for t in args), **kwargs)
+    for independent in (False, True):
+        out = launch_gated_rmsnorm(
+            *args, **kwargs, fp8_scale=None, weights_independent=independent
+        )
+        _assert_close(out, expected)
+        assert out.device == args[0].device and out.dtype == dtype
