+"""Ascend-only registry leaves for eager causal-convolution prefill/decode."""
+
+from __future__ import annotations
+
+import torch
+from tokenspeed_kernel.ops.attention.gdn.triton import CausalConv1dPrefillMetadata
+from tokenspeed_kernel.platform import CapabilityRequirement
+from tokenspeed_kernel.registry import Priority, register_kernel
+from tokenspeed_kernel.signature import format_signatures
+from tokenspeed_kernel_npu.ops.conv import (
+    launch_causal_conv1d_prefill,
+    launch_causal_conv1d_update,
+)
+
+_CONV_DTYPES = {torch.float16, torch.bfloat16, torch.float32}
+_STATE_LAYOUTS = frozenset({"channel_major", "width_major"})
+_WIDTHS = frozenset({2, 3, 4, 5})
+
+
+@register_kernel(
+    "conv",
+    "causal_conv1d_prefill",
+    name="ascend_causal_conv1d_prefill",
+    solution="ascend",
+    capability=CapabilityRequirement(vendors=frozenset({"ascend"})),
+    signatures=format_signatures("x", "dense", _CONV_DTYPES),
+    # Beat the ungated Triton leaf without claiming an optimized implementation.
+    priority=Priority.PORTABLE + 1,
+    traits={"width": _WIDTHS, "state_layout": _STATE_LAYOUTS},
+)
+def ascend_causal_conv1d_prefill(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None,
+    conv_states: torch.Tensor,
+    query_start_loc: torch.Tensor,
+    cache_indices: torch.Tensor | None = None,
+    has_initial_state: torch.Tensor | None = None,
+    activation: str | None = "silu",
+    pad_slot_id: int = -1,
+    validate_data=False,
+    *,
+    prefill_metadata: CausalConv1dPrefillMetadata,
+) -> torch.Tensor:
+    """Return separate [C,T] output and update the indexed raw-input windows.
+
+    Arguments and mutation follow causal_conv1d_fn, including its required
+    per-forward metadata. The implementation validates every supplied schedule
+    field; CPU execution is available only through the direct NPU-package helper.
+    """
+    if x.device.type != "npu":
+        raise ValueError("Ascend causal convolution requires NPU inputs")
+    if prefill_metadata is None:
+        raise ValueError("prefill_metadata is required")
+    return launch_causal_conv1d_prefill(
+        x=x,
+        weight=weight,
+        bias=bias,
+        conv_states=conv_states,
+        query_start_loc=query_start_loc,
+        cache_indices=cache_indices,
+        has_initial_state=has_initial_state,
+        activation=activation,
+        pad_slot_id=pad_slot_id,
+        validate_data=validate_data,
+        batch_indices=prefill_metadata.batch_indices,
+        chunk_offsets=prefill_metadata.chunk_offsets,
+        block_m=prefill_metadata.block_m,
+        cu_seqlens_cpu=prefill_metadata.cu_seqlens_cpu,
+    )
+
+
+@register_kernel(
