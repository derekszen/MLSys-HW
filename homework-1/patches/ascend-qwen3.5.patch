+"""Registry adapters for correctness-first, eager Ascend GDN scans."""
+
+from __future__ import annotations
+
+import torch
+from tokenspeed_kernel.ops.attention.gdn import (
+    GdnChunkPrefillResult,
+    GdnStateCheckpoints,
+)
+from tokenspeed_kernel.platform import CapabilityRequirement
+from tokenspeed_kernel.registry import Priority, register_kernel
+from tokenspeed_kernel.signature import format_signatures
+from tokenspeed_kernel_npu.ops.gdn import (
+    launch_gdn_chunk_prefill,
+    launch_gdn_decode_step,
+)
+
+
+@register_kernel(
+    "attention",
+    "gdn_chunk_prefill",
+    name="ascend_gdn_chunk_prefill",
+    solution="ascend",
+    capability=CapabilityRequirement(vendors=frozenset({"ascend"})),
+    signatures=format_signatures(
+        ("q", "k", "v"), "dense", {torch.float16, torch.bfloat16, torch.float32}
+    ),
+    priority=Priority.PORTABLE,
+    traits={
+        "num_v_gte_num_q": frozenset({True}),
+        "output_h": frozenset({False}),
+        "qk_l2norm": frozenset({False, True}),
+        "state_checkpoints": frozenset({False, True}),
+    },
+)
+def ascend_gdn_chunk_prefill(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    g: torch.Tensor,
+    beta: torch.Tensor,
+    *,
+    scale: float | None,
+    initial_state: torch.Tensor,
+    cu_seqlens: torch.Tensor,
+    qk_l2norm: bool,
+    output_final_state: bool,
+    output_h: bool,
+    state_checkpoints: GdnStateCheckpoints | None,
+) -> GdnChunkPrefillResult:
+    """Return the shared structured result, with K-last FP32 final state.
+
+    Arguments follow gdn_chunk_prefill. Backend-native output_h is unsupported;
+    caller-owned GdnStateCheckpoints are stored during the recurrence instead.
+    All execution and metadata synchronization live in tokenspeed-kernel-npu.
+    """
+    if output_h:
+        raise ValueError("Ascend GDN does not support backend-native output_h")
+    if q.device.type != "npu":
+        raise ValueError("Ascend GDN requires NPU inputs")
+    out, final_state = launch_gdn_chunk_prefill(
+        q=q,
+        k=k,
+        v=v,
+        g=g,
+        beta=beta,
+        scale=scale,
+        initial_state=initial_state,
+        cu_seqlens=cu_seqlens,
+        qk_l2norm=qk_l2norm,
+        output_final_state=output_final_state,
+        checkpoint_every_n_tokens=(
+            None
+            if state_checkpoints is None
+            else state_checkpoints.every_n_tokens
+        ),
+        checkpoint_states=(
+            None if state_checkpoints is None else state_checkpoints.states
+        ),
+        checkpoint_cu_starts=(
+            None if state_checkpoints is None else state_checkpoints.cu_starts
+        ),
+    )
+    return GdnChunkPrefillResult(out=out, final_state=final_state)
+
+
+@register_kernel(
+    "attention",
+    "gdn_decode_step",
+    name="ascend_gdn_decode_step",
+    solution="ascend",
+    capability=CapabilityRequirement(vendors=frozenset({"ascend"})),
+    signatures=format_signatures(
+        ("q", "k", "v"), "dense", {torch.float16, torch.bfloat16, torch.float32}
+    ),
+    priority=Priority.PORTABLE,
+    traits={"strided_qkv": frozenset({False, True})},
+)
+def ascend_gdn_decode_step(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    *,
+    A_log: torch.Tensor,
+    a: torch.Tensor,
+    dt_bias: torch.Tensor,
+    b: torch.Tensor,
+    initial_state: torch.Tensor,
+    initial_state_indices: torch.Tensor,
+    scale: float | None,
+    output_state_indices: torch.Tensor | None,
+    use_qk_l2norm: bool,
+) -> torch.Tensor:
+    """Return [B,1,HV,V] in q.dtype, writing the requested FP32 pool rows.
+
+    Arguments follow gdn_decode_step, including separate read/write indices,
+    negative padding indices, custom scale, normalization and strided Q/K/V.
+    This eager implementation is not graph-capturable and has no MTP variant.
+    """
+    if q.device.type != "npu":
+        raise ValueError("Ascend GDN requires NPU inputs")
+    return launch_gdn_decode_step(
+        q=q,
+        k=k,
+        v=v,
+        A_log=A_log,
+        a=a,
+        dt_bias=dt_bias,
+        b=b,
+        initial_state=initial_state,
+        initial_state_indices=initial_state_indices,
+        scale=scale,
+        output_state_indices=output_state_indices,
+        use_qk_l2norm=use_qk_l2norm,
+    )
