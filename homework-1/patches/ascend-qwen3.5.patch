+def _reference(x, weight, z, *, eps, group_size, norm_before_gate, sigmoid_gate):
+    """Scalar Python float64 oracle, no implementation/reference-op reuse."""
+    width = x.shape[-1]
+    group = width if group_size is None else group_size
+    rows = x.reshape(-1, width).tolist()
+    gates = None if z is None else z.reshape(-1, width).tolist()
+    weights = weight.tolist()
+    result = []
+    for row_index, row in enumerate(rows):
+        output = []
+        for start in range(0, width, group):
+            values = row[start : start + group]
+            activation = [1.0] * group
+            if gates is not None:
+                gate_values = gates[row_index][start : start + group]
+                activation = [1.0 / (1.0 + math.exp(-v)) for v in gate_values]
+                if not sigmoid_gate:
+                    activation = [v * a for v, a in zip(gate_values, activation)]
+                if not norm_before_gate:
+                    values = [v * a for v, a in zip(values, activation)]
+            rms = math.sqrt(math.fsum(v * v for v in values) / group + eps)
+            for col, value in enumerate(values):
+                index = col if len(weights) == group else start + col
+                y = value / rms * weights[index]
+                if norm_before_gate:
+                    y *= activation[col]
+                output.append(y)
+        result.append(output)
+    return torch.tensor(result, dtype=x.dtype).reshape(x.shape)
+
+
+def _inputs(shape, dtype, *, shared, group_size):
+    gen = torch.Generator().manual_seed(169)
+    x = (torch.randn(shape, generator=gen) * 2).to(dtype)
+    z = (torch.randn(shape, generator=gen) * 3).to(dtype)
+    width = shape[-1]
+    group = width if group_size is None else group_size
+    weight = torch.randn(group if shared else width, generator=gen).to(dtype)
+    return x, weight, z
+
+
+def _assert_close(out, expected):
+    if out.dtype == torch.bfloat16:
+        rtol, atol = 8e-3, 2e-3
+    elif out.dtype == torch.float16:
+        rtol, atol = 1e-3, 3e-4
+    else:
+        rtol, atol = 3e-6, 2e-6
+    torch.testing.assert_close(out.cpu(), expected, rtol=rtol, atol=atol)
