+"""Real Ascend Gemma layer and kernel facade, checked against a CPU FP64 oracle."""
+
+import pytest
+import torch
+
+
+@pytest.fixture
+def npu():
+    pytest.importorskip("torch_npu")
+    if not torch.npu.is_available():
+        pytest.skip("Ascend Gemma RMSNorm tests require an NPU")
+    return torch.device("npu", torch.npu.current_device())
+
+
+def _reference(x, weight, eps, residual=None):
+    # Only the oracle runs on CPU. Round the residual add before its statistics.
+    values = x.double()
+    if residual is not None:
+        values = (values + residual.double()).to(x.dtype).double()
+    out = values / (values.square().mean(dim=-1, keepdim=True) + eps).sqrt()
+    return (out * (1.0 + weight.double())).to(x.dtype), values.to(x.dtype)
+
+
+def _inputs(rows, width, dtype):
+    generator = torch.Generator().manual_seed(169)
+    x = (torch.randn(rows, width, generator=generator) * 2).to(dtype)
+    residual = torch.randn(rows, width, generator=generator).to(dtype)
+    weight = (torch.randn(width, generator=generator) * 0.4).to(dtype)
+    return x, residual, weight
+
+
+def _layer(weight, eps, device):
+    from tokenspeed.runtime.layers.layernorm import GemmaRMSNorm
+
+    layer = GemmaRMSNorm(weight.numel(), eps=eps).to(device=device, dtype=weight.dtype)
+    layer.weight.weight_loader(layer.weight, weight.to(device))
+    return layer
+
+
+def _assert_close(actual, expected):
+    if expected.dtype == torch.bfloat16:
+        rtol, atol = 8e-3, 2e-3
+    elif expected.dtype == torch.float16:
+        rtol, atol = 1e-3, 3e-4
+    else:
+        rtol, atol = 3e-6, 2e-6
+    torch.testing.assert_close(actual.cpu(), expected, rtol=rtol, atol=atol)
+
+
+@pytest.mark.parametrize("api", ["facade", "layer"])
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16, torch.float32])
+@pytest.mark.parametrize("width", [128, 512, 4096])
+@pytest.mark.parametrize("with_residual", [False, True])
+def test_gemma_values(npu, api, dtype, width, with_residual):
+    from tokenspeed_kernel.ops.layernorm import gemma_rmsnorm
+
+    host_x, host_residual, weight = _inputs(7, width, dtype)
+    eps = 0.03125
+    expected, expected_residual = _reference(
+        host_x, weight, eps, host_residual if with_residual else None
+    )
+    x, residual = host_x.to(npu), host_residual.to(npu)
+    if api == "facade":
+        result = gemma_rmsnorm(
+            x, weight.to(npu), eps, residual=residual if with_residual else None
+        )
+    else:
+        result = _layer(weight, eps, npu)(x, residual if with_residual else None)
+    if with_residual:
+        out, residual_out = result
+        assert out is x and residual_out is residual
+        torch.testing.assert_close(residual.cpu(), expected_residual, rtol=0, atol=0)
+    else:
+        out = result
+        torch.testing.assert_close(x.cpu(), host_x, rtol=0, atol=0)
+    assert out.device == npu and out.dtype == dtype
+    _assert_close(out, expected)
+
+
+@pytest.mark.parametrize("activation_dtype", [torch.bfloat16, torch.float32])
+def test_weight_offset_is_not_rounded_to_bf16(npu, activation_dtype):
+    from tokenspeed_kernel.ops.layernorm import gemma_rmsnorm
+
+    # 1 + 2^-8 is halfway between BF16 values at 1. Rounding gamma to BF16
+    # would lose the offset before the multiply, including with FP32 activations.
+    x = torch.tensor([[1.0, 1.0, 1.0, 2.0] * 32], dtype=activation_dtype)
+    weight = torch.full((128,), 2**-8, dtype=torch.bfloat16)
+    expected, _ = _reference(x, weight, 0.03125)
+    rounded_gamma_result, _ = _reference(x, torch.zeros_like(weight), 0.03125)
+    assert not torch.equal(expected, rounded_gamma_result)
+    out = gemma_rmsnorm(x.to(npu), weight.to(npu), 0.03125)
+    if activation_dtype == torch.bfloat16:
+        torch.testing.assert_close(out.cpu(), expected, rtol=0, atol=0)
+    else:
+        _assert_close(out, expected)
+
+
+def test_residual_rounds_before_statistics(npu):
+    # The add is a BF16 tie and rounds back to 1. With eps=4, normalizing
+    # the unrounded 1 + 2^-8 would produce a different BF16 output.
+    x = torch.ones(2, 128, dtype=torch.bfloat16)
+    residual = torch.full_like(x, 2**-8)
+    weight = torch.zeros(128, dtype=x.dtype)
+    expected, expected_residual = _reference(x, weight, 4.0, residual)
+    unrounded = x.double() + residual.double()
+    unrounded = (
+        unrounded / (unrounded.square().mean(-1, keepdim=True) + 4).sqrt()
+    ).to(x.dtype)
+    assert not torch.equal(expected, unrounded)
+    device_x, device_residual = x.to(npu), residual.to(npu)
+    out, updated = _layer(weight, 4.0, npu)(device_x, device_residual)
+    assert out is device_x and updated is device_residual
+    torch.testing.assert_close(out.cpu(), expected, rtol=0, atol=0)
+    torch.testing.assert_close(updated.cpu(), expected_residual, rtol=0, atol=0)
+
+
+@pytest.mark.parametrize("reload", ["weight_loader", "state_dict"])
+@pytest.mark.parametrize(
+    "method", ["forward", "add_norm_with_fp8", "add_norm_with_fp4"]
+)
+def test_reloaded_weights_and_unquantized_add_norm(npu, reload, method):
+    x, residual, weight = _inputs(3, 512, torch.bfloat16)
+    eps = 1e-6
+    layer = _layer(weight, eps, npu)
+    for loaded in (weight, weight * -0.5 + 0.00390625):
+        if reload == "weight_loader":
+            layer.weight.weight_loader(layer.weight, loaded.to(npu))
+        else:
+            layer.load_state_dict({"weight": loaded.to(npu)})
+        expected, expected_residual = _reference(x, loaded, eps, residual)
+        device_x, device_residual = x.to(npu), residual.to(npu)
+        if method == "forward":
+            out, updated = layer(device_x, device_residual)
+        elif method == "add_norm_with_fp8":
+            out, quantized, updated = layer.add_norm_with_fp8(
+                device_x, device_residual, None
+            )
+            assert quantized is None
+        else:
+            out, quantized, updated = layer.add_norm_with_fp4(
+                device_x, device_residual, None
+            )
+            assert quantized is None
+        assert out is device_x and updated is device_residual
+        assert out.device == npu
+        _assert_close(out, expected)
+        torch.testing.assert_close(updated.cpu(), expected_residual, rtol=0, atol=0)
+        # Also exercise the no-residual path after each reload.
+        expected_plain, _ = _reference(x, loaded, eps)
+        _assert_close(layer(x.to(npu)), expected_plain)
+
+
+@pytest.mark.parametrize("rows", [0, 2])
+@pytest.mark.parametrize("scales", ["fp8", "fp4", "both"])
+def test_facade_rejects_quantization_before_mutating_inputs(npu, rows, scales):
+    from tokenspeed_kernel.ops.layernorm import gemma_add_rmsnorm
+
+    x, residual, weight = _inputs(rows, 128, torch.bfloat16)
+    device_x, device_residual = x.to(npu), residual.to(npu)
+    scale = torch.tensor([0.1], device=npu)
+    with pytest.raises(NotImplementedError, match="FP8 or FP4"):
+        gemma_add_rmsnorm(
+            device_x,
+            device_residual,
+            weight.to(npu),
+            1e-6,
+            fp8_scale=scale if scales in ("fp8", "both") else None,
+            fp4_scale=scale if scales in ("fp4", "both") else None,
+            fp4_copy_supported=False,
+        )
+    torch.testing.assert_close(device_x.cpu(), x, rtol=0, atol=0)
+    torch.testing.assert_close(device_residual.cpu(), residual, rtol=0, atol=0)
+
+
+@pytest.mark.parametrize("method", ["add_norm_with_fp8", "add_norm_with_fp4"])
+@pytest.mark.parametrize("rows", [0, 2])
+def test_layer_rejects_quantization(npu, method, rows):
+    x, residual, weight = _inputs(rows, 128, torch.bfloat16)
+    layer = _layer(weight, 1e-6, npu)
+    device_x, device_residual = x.to(npu), residual.to(npu)
+    scale = torch.tensor([0.1], device=npu)
+    with pytest.raises(NotImplementedError, match="FP8 or FP4"):
+        if method == "add_norm_with_fp8":
+            layer.add_norm_with_fp8(device_x, device_residual, scale)
+        else:
+            layer.add_norm_with_fp4(device_x, device_residual, scale)
+    torch.testing.assert_close(device_x.cpu(), x, rtol=0, atol=0)
+    torch.testing.assert_close(device_residual.cpu(), residual, rtol=0, atol=0)
+
+
+def test_empty_layer_preserves_identity(npu):
+    x = torch.empty(0, 128, dtype=torch.bfloat16, device=npu)
+    residual = torch.empty_like(x)
+    layer = _layer(torch.zeros(128, dtype=x.dtype), 1e-6, npu)
+    assert layer(x) is x
+    out, updated = layer(x, residual)
+    assert out is x and updated is residual
+    for method in (layer.add_norm_with_fp8, layer.add_norm_with_fp4):
+        out, quantized, updated = method(x, residual, None)
+        assert out is x and updated is residual and quantized is None
+
+
+@pytest.mark.parametrize("bad_residual", ["shape", "dtype", "device"])
+def test_residual_contract_is_not_silently_broadcast_or_cast(npu, bad_residual):
+    from tokenspeed_kernel.ops.layernorm import gemma_rmsnorm
+
+    x = torch.ones(2, 128, dtype=torch.bfloat16, device=npu)
+    weight = torch.zeros(128, dtype=x.dtype, device=npu)
+    if bad_residual == "shape":
+        residual = torch.ones(1, 128, dtype=x.dtype, device=npu)
+    elif bad_residual == "dtype":
+        residual = torch.ones_like(x, dtype=torch.float32)
+    else:
+        residual = torch.ones(2, 128, dtype=x.dtype)
+    with pytest.raises(ValueError, match="residual"):
+        gemma_rmsnorm(x, weight, 1e-6, residual=residual)
+    torch.testing.assert_close(x.cpu(), torch.ones_like(x.cpu()), rtol=0, atol=0)
