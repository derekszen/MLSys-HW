+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float16])
+def test_prefill_request_and_future_isolation(ops, dtype):
+    module, dispatch = ops
+    generator = torch.Generator().manual_seed(32)
+    q = _randn((8, 8, 256), dtype, generator).to("npu")
+    k = _randn((8, 2, 256), dtype, generator).to("npu")
+    v = _randn(k.shape, dtype, generator).to("npu")
+    offsets = [0, 3, 8]
+    cumulative = _metadata(offsets)
+    before = module.mha_prefill(q, k, v, cumulative, offsets, 5, **dispatch)
+    # Neither a future token in request 0 nor request 1 can affect token 0.
+    k[2:].fill_(2)
+    v[2:].fill_(-3)
+    after = module.mha_prefill(q, k, v, cumulative, offsets, 5, **dispatch)
+    torch.testing.assert_close(after[:2], before[:2], atol=0, rtol=0)
+    assert not torch.equal(after[2:], before[2:])
