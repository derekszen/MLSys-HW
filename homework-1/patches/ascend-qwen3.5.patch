+@pytest.mark.parametrize("causal", [False, True])
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float16])
+def test_extend_request_length_and_future_isolation(ops, causal, dtype):
+    module, dispatch = ops
+    q_lengths, kv_lengths = [3, 5], [130, 199]
+    host = _paged_case(q_lengths, kv_lengths, dtype=dtype, head_dim=256, page_size=128)
+    q, k, v, table = (tensor.to("npu") for tensor in host)
+    before = _extend(
+        module,
+        dispatch,
+        q,
+        k,
+        v,
+        table,
+        q_lengths,
+        kv_lengths,
+        causal=causal,
+        scale=None,
+    )
+    # Change another request, unused physical pages, and padding past length.
+    other_pages = host[3][1].long().to("npu")
+    k[other_pages] = 2
+    v[other_pages] = -3
+    k[-2:] = 2
+    v[-2:] = -3
+    last_page = int(host[3][0, 1])
+    k[last_page, 2:] = 2
+    v[last_page, 2:] = -3
+    after = _extend(
+        module,
+        dispatch,
+        q,
+        k,
+        v,
+        table,
+        q_lengths,
+        kv_lengths,
+        causal=causal,
+        scale=None,
+    )
+    torch.testing.assert_close(after[:3], before[:3], atol=0, rtol=0)
+    assert not torch.equal(after[3:], before[3:])
+    # The final cached token is future only for the first two suffix queries.
+    k[last_page, 1] = 2
+    v[last_page, 1] = -3
+    future = _extend(
+        module,
+        dispatch,
+        q,
+        k,
+        v,
+        table,
+        q_lengths,
+        kv_lengths,
+        causal=causal,
+        scale=None,
+    )
+    if causal:
+        torch.testing.assert_close(future[:2], after[:2], atol=0, rtol=0)
+    else:
+        assert not torch.equal(future[:2], after[:2])
