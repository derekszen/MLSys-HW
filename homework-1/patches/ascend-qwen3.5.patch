+"""Device-local eager FP32 gated RMSNorm baseline for Ascend."""
+
+from __future__ import annotations
+
+import torch
+
+_FLOAT_DTYPES = {torch.float16, torch.bfloat16, torch.float32}
+
+
+def launch_gated_rmsnorm(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    z: torch.Tensor | None,
+    eps: float,
+    group_size: int | None,
+    norm_before_gate: bool,
+    sigmoid_gate: bool,
+    fp8_scale: torch.Tensor | None,
+    weights_independent: bool,
+) -> torch.Tensor:
+    """Apply grouped, optionally gated RMSNorm without moving data off device.
+
+    Args:
+        x: FP16, BF16 or FP32 tensor shaped ``[..., width]`` with positive width.
+        weight: Same-device FP16/BF16/FP32 vector of length width, or group_size
+            for a weight shared by all groups. Its dtype may differ from x's.
+        z: Same-device FP16/BF16/FP32 gate shaped like x, or None for no gate.
+        eps: Epsilon added to the FP32 mean square of each group.
+        group_size: Positive divisor of width; None normalizes the whole width.
+        norm_before_gate: True computes norm(x) * gate(z); False computes
+            norm(x * gate(z)). The norm includes its affine weight.
+        sigmoid_gate: True uses sigmoid(z); False uses z * sigmoid(z) (SiLU).
+        fp8_scale: Must be None; FP8 output is not implemented.
+        weights_independent: Producer scheduling hint, accepted for both values.
+            Eager stream ordering loads weights after preceding producers; no
+            PDL launch or early weight load is performed.
+
+    Returns:
+        A fresh tensor shaped like x, rounded once to x's dtype after FP32
+        arithmetic. Inputs are never modified. Strided inputs and empty leading
+        dimensions are supported. Direct CPU calls use the same arithmetic for
+        correctness tests; the registry leaf only accepts NPU inputs.
+    """
+    if fp8_scale is not None:
+        raise NotImplementedError("Ascend gated RMSNorm does not support FP8 output")
+    if x.ndim == 0 or x.shape[-1] == 0:
+        raise ValueError("x must have a positive last dimension")
+    if x.dtype not in _FLOAT_DTYPES:
+        raise ValueError("x must be FP16, BF16 or FP32")
+    width = x.shape[-1]
+    group = width if group_size is None else group_size
+    if isinstance(group, bool) or not isinstance(group, int) or group <= 0:
+        raise ValueError("group_size must be a positive integer or None")
+    if width % group:
+        raise ValueError("group_size must divide the last dimension of x")
+    if weight.shape not in ((width,), (group,)):
+        raise ValueError("weight must have shape [width] or [group_size]")
+    if weight.dtype not in _FLOAT_DTYPES:
+        raise ValueError("weight must be FP16, BF16 or FP32")
+    if weight.device != x.device:
+        raise ValueError("weight and x must be on the same device")
+    if z is not None:
+        if z.shape != x.shape:
+            raise ValueError("z must have the same shape as x")
+        if z.dtype not in _FLOAT_DTYPES:
+            raise ValueError("z must be FP16, BF16 or FP32")
+        if z.device != x.device:
+            raise ValueError("z and x must be on the same device")
+
+    if x.numel() == 0:
+        return torch.empty_like(x)
+
+    group_shape = (*x.shape[:-1], width // group, group)
+    values = x.float().reshape(group_shape)
+    gate = None
+    if z is not None:
+        gate_values = z.float().reshape(group_shape)
+        gate = torch.sigmoid(gate_values)
+        if not sigmoid_gate:
+            gate = gate_values * gate
+        if not norm_before_gate:
+            values = values * gate
+
+    inv_rms = torch.rsqrt(values.square().mean(dim=-1, keepdim=True) + eps)
+    # [1, group] broadcasts shared weights; [groups, group] uses per-feature ones.
+    out = values * inv_rms * weight.float().reshape(-1, group)
+    if gate is not None and norm_before_gate:
+        out = out * gate
+    return out.reshape(x.shape).to(x.dtype)
+
+
+__all__ = ["launch_gated_rmsnorm"]
