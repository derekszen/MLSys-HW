+"""Real two-rank HcclBackend regression coverage; see docs/hccl-torch29.md."""
+
+import importlib.util
+import os
+import time
+import traceback
+from datetime import timedelta
+from pathlib import Path
+
+import pytest
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+
+WORLD = (0, 1)
+PROCESS_GROUP_TIMEOUT_SECONDS = 60
+PARENT_TIMEOUT_SECONDS = 240
+CLEANUP_TIMEOUT_SECONDS = 5
+
+
+def _assert_exact(actual: torch.Tensor, expected: torch.Tensor) -> None:
+    torch.testing.assert_close(actual.cpu(), expected, rtol=0, atol=0)
+
+
+def _check_floating_collectives(backend, rank: int, device, dtype) -> None:
+    base = torch.arange(6, dtype=dtype).reshape(2, 3)
+    peers = [base + peer * 16 for peer in WORLD]
+    tensor = peers[rank].to(device)
+
+    # Use an offset output view so the supplied buffer, not a replacement,
+    # must receive the gathered data without overwriting neighboring rows.
+    storage = torch.full((6, 3), -99, dtype=dtype, device=device)
+    output = storage[1:5]
+    alias, pointer = output, output.data_ptr()
+    assert backend.all_gather_single(output, tensor, WORLD) is None
+    assert output is alias and output.data_ptr() == pointer
+    _assert_exact(output, torch.cat(peers))
+    _assert_exact(storage[[0, 5]], torch.full((2, 3), -99, dtype=dtype))
+    _assert_exact(tensor, peers[rank])
+
+    for dim in (0, 1, -1):
+        _assert_exact(
+            backend.all_gather(tensor, WORLD, dim=dim), torch.cat(peers, dim=dim)
+        )
+
+    reduced = tensor.clone()
+    pointer = reduced.data_ptr()
+    assert backend.all_reduce(reduced, WORLD) is reduced
+    assert reduced.data_ptr() == pointer
+    _assert_exact(reduced, peers[0] + peers[1])
+
+    base = torch.arange(12, dtype=dtype).reshape(4, 3)
+    partial = (base + rank * 16).to(device)
+    expected = (2 * base + 16)[rank * 2 : (rank + 1) * 2]
+    _assert_exact(backend.reduce_scatter(partial, WORLD), expected)
+    _assert_exact(backend.token_reduce_scatter(partial, WORLD, [2, 2]), expected)
+    _assert_exact(partial, base + rank * 16)
+
+    # Exercise both padding directions, empty owners, and the equal-row path.
+    for counts in ([1, 3], [3, 1], [0, 3], [3, 0], [2, 2]):
+        shards = [
+            torch.arange(count * 3, dtype=dtype).reshape(count, 3) + peer * 16
+            for peer, count in enumerate(counts)
+        ]
+        # A strided input also checks the backend's token gather packing.
+        local = shards[rank].t().contiguous().t().to(device)
+        gathered = backend.token_all_gather(local, WORLD, counts)
+        _assert_exact(gathered, torch.cat(shards))
+        assert gathered.is_contiguous()
+
+        base = torch.arange(sum(counts) * 3, dtype=dtype).reshape(-1, 3)
+        partial = (base + rank * 16).t().contiguous().t().to(device)
+        scattered = backend.token_reduce_scatter(partial, WORLD, counts)
+        offset = sum(counts[:rank])
+        _assert_exact(
+            scattered, (2 * base + 16)[offset : offset + counts[rank]]
+        )
+        assert scattered.is_contiguous()
+
+
+def _check_int64_max(backend, rank: int, device) -> None:
+    # Values exceed FP64's exact integer range. Equal high words with different
+    # low words also catch lossy casts and independent INT32 word reductions.
+    peers = torch.tensor(
+        [
+            [
+                (1 << 62) + 1,
+                (1 << 61) + 0xFFFFFFFF,
+                -(1 << 63),
+                -(1 << 60) + 7,
+                (1 << 63) - 2,
+                -1,
+            ],
+            [
+                (1 << 62) + 3,
+                (1 << 61) + 0x100000000,
+                -(1 << 63) + 1,
+                -(1 << 60) + 9,
+                (1 << 63) - 1,
+                0,
+            ],
+        ],
+        dtype=torch.int64,
+    )
+    for count in (1, 6, 512):  # Include the 4 KiB small-payload boundary.
+        values = peers.repeat(1, (count + 5) // 6)[:, :count]
+        expected = values.amax(dim=0)
+        for strided in (False, True):
+            # Different local layouts must still choose the same collective.
+            if strided and rank == 0:
+                backing = torch.full(
+                    (count * 3,), -123, dtype=torch.int64, device=device
+                )
+                tensor = backing[1::3]
+                tensor.copy_(values[rank].to(device))
+                # A one-element view reports contiguous despite this stride.
+                assert tensor.stride(0) == 3
+            else:
+                backing = None
+                tensor = values[rank].to(device).clone()
+            pointer = tensor.data_ptr()
+            result = backend.all_reduce(tensor, WORLD, op=dist.ReduceOp.MAX)
+            assert result is tensor and result.data_ptr() == pointer
+            _assert_exact(result, expected)
+            if backing is not None:
+                guard = torch.full((count,), -123, dtype=torch.int64)
+                _assert_exact(backing[0::3], guard)
+                _assert_exact(backing[2::3], guard)
+
+    # A transposed matrix requires reshape/copy-back, unlike a strided vector.
+    tensor = peers[rank].reshape(2, 3).t().contiguous().to(device).t()
+    pointer = tensor.data_ptr()
+    assert backend.all_reduce(tensor, WORLD, op=dist.ReduceOp.MAX) is tensor
+    assert tensor.data_ptr() == pointer
+    _assert_exact(tensor, peers.amax(dim=0).reshape(2, 3))
+
+
+def _check_singleton(backend, rank: int, device, dtype) -> None:
+    # No singleton process group is registered: identity paths need none.
+    group = (rank,)
+    expected = torch.arange(6, dtype=dtype).reshape(2, 3)
+    tensor = expected.to(device)
+    for op in (dist.ReduceOp.SUM, dist.ReduceOp.MAX):
+        assert backend.all_reduce(tensor, group, op=op) is tensor
+    for dim in (0, 1, -1):
+        assert backend.all_gather(tensor, group, dim=dim) is tensor
+    assert backend.reduce_scatter(tensor, group) is tensor
+    assert backend.token_reduce_scatter(tensor, group, [2]) is tensor
+    _assert_exact(tensor, expected)
+
+    output = torch.full_like(tensor, -99)
+    pointer = output.data_ptr()
+    assert backend.all_gather_single(output, tensor, group) is None
+    assert output.data_ptr() == pointer
+    _assert_exact(output, expected)
+    _assert_exact(backend.token_all_gather(tensor, group, [2]), expected)
+
+    output.fill_(-99)
+    assert backend.all_to_all_single(output, tensor, group) is None
+    assert output.data_ptr() == pointer
+    _assert_exact(output, expected)
+
+    key = torch.tensor([(1 << 62) + 3], dtype=torch.int64, device=device)
+    assert backend.all_reduce(key, group, op=dist.ReduceOp.MAX) is key
+    _assert_exact(key, torch.tensor([(1 << 62) + 3], dtype=torch.int64))
+
+
+def _worker(rank: int, rendezvous: str, error_path: str) -> None:
+    try:
+        import torch_npu  # noqa: F401 -- registers the NPU/HCCL implementations
+
+        from tokenspeed.runtime.distributed.comm_backend.hccl import HcclBackend
+        from tokenspeed.runtime.distributed.process_group_manager import (
+            process_group_manager as pg_manager,
+        )
+
+        device = torch.device(f"npu:{rank}")
+        torch.npu.set_device(device)
+        dist.init_process_group(
+            backend="hccl",
+            init_method=rendezvous,
+            rank=rank,
+            world_size=len(WORLD),
+            timeout=timedelta(seconds=PROCESS_GROUP_TIMEOUT_SECONDS),
+        )
+        # Register the world group this child owns; do not create another HCCL
+        # communicator through the runtime's general initialization machinery.
+        pg_manager.register_process_group("hccl", WORLD, dist.group.WORLD)
+        backend = HcclBackend()
+        for dtype in (torch.bfloat16, torch.float32):
+            _check_floating_collectives(backend, rank, device, dtype)
+            _check_singleton(backend, rank, device, dtype)
+        _check_int64_max(backend, rank, device)
+        torch.npu.synchronize()
+    except BaseException:
+        # Persist the traceback before group destruction, which can itself hang
+        # after a peer fails. The parent does not depend on a queue feeder.
+        Path(error_path).write_text(traceback.format_exc())
+        raise
+    finally:
+        if dist.is_initialized():
+            dist.destroy_process_group()
+
+
+def _stop_children(processes) -> None:
+    # Only touch Process objects created by this test; never kill by name/PID
+    # search or use a process-group-wide signal on a shared accelerator host.
+    for process in processes:
+        if process.is_alive():
+            process.terminate()
+    deadline = time.monotonic() + CLEANUP_TIMEOUT_SECONDS
+    for process in processes:
+        process.join(timeout=max(0, deadline - time.monotonic()))
+    for process in processes:
+        if process.is_alive():
+            process.kill()
+    deadline = time.monotonic() + CLEANUP_TIMEOUT_SECONDS
+    for process in processes:
+        process.join(timeout=max(0, deadline - time.monotonic()))
+
+
+def test_hccl_torch29_two_ranks(tmp_path: Path) -> None:
+    if importlib.util.find_spec("torch_npu") is None:
+        pytest.skip("requires torch-npu and two Ascend NPUs")
+    import torch_npu  # noqa: F401 -- registers torch.npu before probing it
+
+    if not torch.npu.is_available():
+        pytest.skip("requires two Ascend NPUs")
+    assert os.environ.get("ASCEND_RT_VISIBLE_DEVICES") == "0,1", (
+        "set ASCEND_RT_VISIBLE_DEVICES=0,1 in the parent before starting pytest"
+    )
+    assert torch.npu.device_count() == 2, "requires exactly two visible NPUs"
+
+    # A fresh file rendezvous avoids reserving/releasing a TCP port. Children
+    # inherit the parent's visibility and HCCL_NPU_SOCKET_PORT_RANGE unchanged.
+    rendezvous = (tmp_path / "rendezvous").as_uri()
+    errors = [tmp_path / f"rank-{rank}.error" for rank in WORLD]
+    context = mp.get_context("spawn")
+    processes = []
+    deadline = time.monotonic() + PARENT_TIMEOUT_SECONDS
+    try:
+        for rank in WORLD:
+            process = context.Process(
+                target=_worker, args=(rank, rendezvous, str(errors[rank]))
+            )
+            process.start()
+            processes.append(process)
+        while True:
+            failures = [
+                f"rank {rank}:\n{path.read_text()}"
+                for rank, path in enumerate(errors)
+                if path.exists()
+            ]
+            if failures:
+                pytest.fail("\n".join(failures), pytrace=False)
+            exitcodes = [process.exitcode for process in processes]
+            if any(code not in (None, 0) for code in exitcodes):
+                pytest.fail(f"HCCL child failed: exit codes {exitcodes}")
+            if all(code == 0 for code in exitcodes):
+                break
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                pytest.fail(
+                    f"HCCL ranks exceeded {PARENT_TIMEOUT_SECONDS}s parent deadline; "
+                    f"exit codes {exitcodes}"
+                )
+            time.sleep(min(0.1, remaining))
+    finally:
+        _stop_children(processes)
