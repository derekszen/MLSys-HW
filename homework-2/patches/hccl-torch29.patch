+
+
+@pytest.mark.parametrize("dtype", [torch.uint8, torch.int8, torch.float64])
+def test_override_refuses_unsupported_weight_dtypes(dtype):
+    global_server_args_dict["lm_head_compute_dtype"] = "float32"
