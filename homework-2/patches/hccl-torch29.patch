+"""Real NPU device capture from an already-running issuing thread; no mocks."""
+
+import json
+import os
+import threading
+from concurrent.futures import ThreadPoolExecutor
+
+import pytest
+
+torch = pytest.importorskip("torch")
+pytest.importorskip("torch_npu")
+if not torch.npu.is_available():
+    pytest.skip("requires an available Ascend NPU", allow_module_level=True)
+
+from tokenspeed.runtime.engine.io_struct import ProfileReq, ProfileReqType
+from tokenspeed.runtime.engine.request_handler import RequestHandler
+from tokenspeed.runtime.execution.forward_batch_info import ForwardMode
+from tokenspeed.runtime.utils.server_args import ServerArgs
+
+
+def _handler() -> RequestHandler:
+    # Exercise the real handler's profiling lifecycle without loading model
+    # weights/tokenizers or launching the scheduler. Only profile-owned state
+    # and the server's device selection are needed by this isolated test.
+    handler = RequestHandler.__new__(RequestHandler)
+    handler.server_args = ServerArgs.__new__(ServerArgs)
+    handler.server_args.device = "npu"
+    handler.forward_ct = 0
+    handler.attn_tp_size = 1
+    handler.attn_tp_cpu_group = None
+    handler.profile_rank_tag = "TP0"
+    handler._profile_sync_buf = torch.zeros(1, dtype=torch.int32, device="cpu")
+    handler.init_profiler()
+    return handler
+
+
+def _start(output_dir, *, activities, **kwargs):
+    return ProfileReq(
+        type=ProfileReqType.START_PROFILE,
+        output_dir=str(output_dir),
+        activities=activities,
+        profile_id="npu-test",
+        with_stack=False,
+        record_shapes=False,
+        **kwargs,
+    )
+
+
+@pytest.fixture
+def session(tmp_path, monkeypatch):
+    # Keep the vendor's raw diagnostic files inside the test directory too.
+    monkeypatch.chdir(tmp_path)
+    handler = _handler()
+    device = torch.npu.current_device()
+
+    def prepare():
+        torch.npu.set_device(device)
+        x = torch.ones((256, 256), dtype=torch.float16, device=f"npu:{device}")
+        weight = torch.ones_like(x)
+
+        def forward():
+            with torch.inference_mode():
+                result = torch.relu(torch.mm(x, weight) + 1)
+                torch.npu.synchronize()
+                value = result[0, 0].item()
+            return threading.get_native_id(), value
+
+        forward()  # Warm up before the profiling window.
+        return threading.get_native_id(), forward
+
+    with ThreadPoolExecutor(
+        max_workers=1, thread_name_prefix="forward-like"
+    ) as worker:
+        thread_id, forward = worker.submit(prepare).result(timeout=60)
+        try:
+            yield handler, worker, thread_id, forward
+        finally:
+            if handler.profile_in_progress:
+                handler.stop_profile()
+
+
+def _assert_device_trace(path):
+    assert path.is_file() and path.stat().st_size > 0
+    with path.open() as source:
+        document = json.load(source)
+    events = document["traceEvents"] if isinstance(document, dict) else document
+    # Host aten ranges alone are not proof of capture from the issuing thread.
+    kernels = [
+        event
+        for event in events
+        if event.get("ph") == "X"
+        and (
+            event.get("cat", "").lower() == "kernel"
+            or event.get("args", {}).get("Task Type") in {"AI_CORE", "AI_VECTOR_CORE", "MIX_AIC"}
+        )
+        and event.get("dur", 0) > 0
+    ]
+    assert kernels, "expected actual NPU device kernels, not only host annotations"
+    assert any(
+        "matmul" in event.get("name", "").lower()
+        or "gemm" in event.get("name", "").lower()
+        for event in kernels
+    ), "the forward thread's matrix multiply must appear as device work"
+
+
+@pytest.mark.parametrize("activities", [["NPU"], ["CPU", "NPU"]])
+def test_captures_device_work_from_preexisting_forward_thread(
+    session, tmp_path, activities
+):
+    handler, worker, thread_id, forward = session
+    started = handler.profile(_start(tmp_path, activities=activities))
+    assert started.success, started.message
+    actual_thread, value = worker.submit(forward).result(timeout=60)
+    assert actual_thread == thread_id
+    assert value == 257
+    stopped = handler.profile(ProfileReq(type=ProfileReqType.STOP_PROFILE))
+    assert stopped.success, stopped.message
+    assert not handler.profile_in_progress
+    assert handler.torch_profiler is None
+    _assert_device_trace(tmp_path / "npu-test-TP0.trace.json")
+    assert not (tmp_path / "npu-test-TP0.trace.json.gz").exists()
+    assert worker.submit(threading.get_native_id).result(timeout=10) == thread_id
+
+
+def test_num_steps_bounds_device_capture(session, tmp_path):
+    handler, worker, _, forward = session
+    result = handler.profile(_start(tmp_path, activities=["NPU"], num_steps=1))
+    assert result.success, result.message
+    worker.submit(forward).result(timeout=60)
+    handler.forward_ct = 1
+    handler._profile_batch_predicate(ForwardMode.DECODE)
+    assert not handler.profile_in_progress
+    assert handler.profiler_target_forward_ct is None
+    _assert_device_trace(tmp_path / "npu-test-TP0.trace.json")
+
+
+def test_unwritable_export_fails_and_allows_retry(session, tmp_path):
+    handler, worker, _, forward = session
+    output = tmp_path / "read-only"
+    output.mkdir()
+    output.chmod(0o555)
+    try:
+        if os.access(output, os.W_OK):
+            pytest.skip("requires filesystem permissions that prevent trace export")
+        result = handler.profile(_start(output, activities=["NPU"], num_steps=2))
+        assert result.success, result.message
+        worker.submit(forward).result(timeout=60)
+        result = handler.profile(ProfileReq(type=ProfileReqType.STOP_PROFILE))
+        assert not result.success
+        assert "Failed to finalize NPU profiling" in result.message
+        assert not (output / "npu-test-TP0.trace.json").exists()
+        assert not handler.profile_in_progress
+        assert handler.torch_profiler is None
+        assert handler.profiler_activities is None
+        assert handler.profiler_target_forward_ct is None
+        handler._profile_batch_predicate(ForwardMode.DECODE)
+    finally:
+        output.chmod(0o755)
+
+    # The failed vendor export must not poison a subsequent real session.
+    result = handler.profile(_start(tmp_path, activities=["NPU"]))
+    assert result.success, result.message
+    worker.submit(forward).result(timeout=60)
+    result = handler.stop_profile()
+    assert result.success, result.message
+    _assert_device_trace(tmp_path / "npu-test-TP0.trace.json")
+
+
+def test_failed_stage_export_disarms_schedule(session, tmp_path):
+    handler, worker, _, forward = session
+    blocked = tmp_path / "not-a-directory"
+    blocked.write_text("block trace-directory creation")
+    result = handler.profile(
+        _start(blocked, activities=["NPU"], profile_by_stage=True, num_steps=1)
+    )
+    assert result.success, result.message
+    handler._profile_batch_predicate(ForwardMode.EXTEND)
+    assert handler.profile_in_progress
+    worker.submit(forward).result(timeout=60)
+    handler._profile_batch_predicate(ForwardMode.DECODE)
+    assert not handler.profile_in_progress
+    assert not handler.profile_by_stage
+    assert handler.torch_profiler is None
+    handler._profile_batch_predicate(ForwardMode.EXTEND)
+    handler._profile_batch_predicate(ForwardMode.DECODE)
+
+
+@pytest.mark.parametrize("incompatible", ["GPU", "PROTON", "CUDA_PROFILER", "MEM"])
+def test_incompatible_request_leaves_state_untouched(session, tmp_path, incompatible):
+    handler, _, _, _ = session
+    before = handler.__dict__.copy()
+    result = handler.profile(
+        _start(
+            tmp_path,
+            activities=["CPU", "NPU", incompatible],
+            start_step=10,
+            num_steps=2,
+            profile_by_stage=True,
+        )
+    )
+    assert not result.success
+    assert incompatible in result.message
+    assert handler.__dict__ == before
+    handler._profile_batch_predicate(ForwardMode.EXTEND)
+    handler._profile_batch_predicate(ForwardMode.DECODE)
+
+
+def test_non_npu_server_rejects_without_mutation(session, tmp_path):
+    handler, _, _, _ = session
+    handler.server_args.device = "cpu"
+    before = handler.__dict__.copy()
+    result = handler.profile(_start(tmp_path, activities=["NPU"]))
+    assert not result.success
+    assert "device='npu'" in result.message
+    assert handler.__dict__ == before
