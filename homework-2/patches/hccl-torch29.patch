+
+def test_override_refuses_incompatible_bias_and_weight_layout():
+    global_server_args_dict["lm_head_compute_dtype"] = "float32"
+    head = ParallelLMHead(2, 3, params_dtype=torch.float16, padding_size=1)
+    with pytest.raises(ValueError, match="floating bias matching"):
+        _logits(_processor(), torch.ones(1, 3), head, embedding_bias=torch.ones(3))
