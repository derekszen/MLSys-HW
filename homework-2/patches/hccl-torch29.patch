+@pytest.mark.parametrize("activation_dtype", [torch.int8, torch.float64])
+def test_conv_rejects_unsupported_activation_dtype(tmp_path, activation_dtype):
+    recipe = _recipe(
+        tmp_path,
+        activation_dtype=activation_dtype,
+        kv_dtype="auto",
+        ssm_dtype="float32",
+    )
+    with pytest.raises(ValueError, match="conv history requires"):
+        recipe.groups()
+
+
+@pytest.mark.parametrize(
+    "name,expected",
+    [
+        ("auto", torch.bfloat16),
+        ("bfloat16", torch.bfloat16),
+        ("float16", torch.float16),
+        ("fp8", torch.float8_e4m3fn),
+        ("fp8_e4m3", torch.float8_e4m3fn),
+        ("mxfp8", torch.float8_e4m3fn),
+    ],
+)
+def test_kv_dtype_resolution_and_python_args(tmp_path, name, expected):
+    args = _server_args(tmp_path, kv_cache_dtype=name)
+    assert args.kv_cache_dtype == ("fp8_e4m3" if name == "fp8" else name)
+    assert resolve_dtype(args.kv_cache_dtype) == expected
