+
+
+@pytest.mark.parametrize(
+    "hidden",
+    [torch.ones(1, 3), torch.ones(1, 2, dtype=torch.int32), torch.ones(1, 1, 2)],
+)
+def test_override_refuses_incompatible_hidden_states(hidden):
