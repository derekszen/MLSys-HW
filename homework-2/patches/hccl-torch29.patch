+def _worker(rank: int, rendezvous: str, error_path: str) -> None:
+    try:
+        import torch_npu  # noqa: F401 -- registers the NPU/HCCL implementations
+
+        from tokenspeed.runtime.distributed.comm_backend.hccl import HcclBackend
+        from tokenspeed.runtime.distributed.process_group_manager import (
+            process_group_manager as pg_manager,
+        )
+
+        device = torch.device(f"npu:{rank}")
+        torch.npu.set_device(device)
+        dist.init_process_group(
+            backend="hccl",
+            init_method=rendezvous,
+            rank=rank,
+            world_size=len(WORLD),
+            timeout=timedelta(seconds=PROCESS_GROUP_TIMEOUT_SECONDS),
+        )
+        # Register the world group this child owns; do not create another HCCL
+        # communicator through the runtime's general initialization machinery.
+        pg_manager.register_process_group("hccl", WORLD, dist.group.WORLD)
+        backend = HcclBackend()
+        for dtype in (torch.bfloat16, torch.float32):
+            _check_floating_collectives(backend, rank, device, dtype)
+            _check_singleton(backend, rank, device, dtype)
+        _check_int64_max(backend, rank, device)
+        torch.npu.synchronize()
+    except BaseException:
+        # Persist the traceback before group destruction, which can itself hang
+        # after a peer fails. The parent does not depend on a queue feeder.
+        Path(error_path).write_text(traceback.format_exc())
+        raise
+    finally:
+        if dist.is_initialized():
+            dist.destroy_process_group()
+
+
+def _stop_children(processes) -> None:
+    # Only touch Process objects created by this test; never kill by name/PID
+    # search or use a process-group-wide signal on a shared accelerator host.
+    for process in processes:
+        if process.is_alive():
+            process.terminate()
+    deadline = time.monotonic() + CLEANUP_TIMEOUT_SECONDS
+    for process in processes:
+        process.join(timeout=max(0, deadline - time.monotonic()))
+    for process in processes:
+        if process.is_alive():
+            process.kill()
+    deadline = time.monotonic() + CLEANUP_TIMEOUT_SECONDS
+    for process in processes:
+        process.join(timeout=max(0, deadline - time.monotonic()))
+
+
+def test_hccl_torch29_two_ranks(tmp_path: Path) -> None:
+    if importlib.util.find_spec("torch_npu") is None:
+        pytest.skip("requires torch-npu and two Ascend NPUs")
+    import torch_npu  # noqa: F401 -- registers torch.npu before probing it
+
+    if not torch.npu.is_available():
+        pytest.skip("requires two Ascend NPUs")
+    assert os.environ.get("ASCEND_RT_VISIBLE_DEVICES") == "0,1", (
+        "set ASCEND_RT_VISIBLE_DEVICES=0,1 in the parent before starting pytest"
+    )
+    assert torch.npu.device_count() == 2, "requires exactly two visible NPUs"
+
+    # A fresh file rendezvous avoids reserving/releasing a TCP port. Children
+    # inherit the parent's visibility and HCCL_NPU_SOCKET_PORT_RANGE unchanged.
+    rendezvous = (tmp_path / "rendezvous").as_uri()
+    errors = [tmp_path / f"rank-{rank}.error" for rank in WORLD]
+    context = mp.get_context("spawn")
+    processes = []
+    deadline = time.monotonic() + PARENT_TIMEOUT_SECONDS
+    try:
+        for rank in WORLD:
+            process = context.Process(
+                target=_worker, args=(rank, rendezvous, str(errors[rank]))
+            )
+            process.start()
+            processes.append(process)
+        while True:
+            failures = [
+                f"rank {rank}:\n{path.read_text()}"
+                for rank, path in enumerate(errors)
+                if path.exists()
+            ]
+            if failures:
+                pytest.fail("\n".join(failures), pytrace=False)
+            exitcodes = [process.exitcode for process in processes]
+            if any(code not in (None, 0) for code in exitcodes):
+                pytest.fail(f"HCCL child failed: exit codes {exitcodes}")
+            if all(code == 0 for code in exitcodes):
+                break
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                pytest.fail(
+                    f"HCCL ranks exceeded {PARENT_TIMEOUT_SECONDS}s parent deadline; "
+                    f"exit codes {exitcodes}"
+                )
+            time.sleep(min(0.1, remaining))
+    finally:
+        _stop_children(processes)
