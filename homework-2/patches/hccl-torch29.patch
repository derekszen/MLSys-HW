+    with pytest.raises(ValueError, match="requires \\[vocab shard, hidden\\]"):
+        _logits(_processor(), torch.ones(1, 2), head)
+
+
+@pytest.mark.parametrize("value", ["float16", "bfloat16", "auto", "float64", "", 32])
+def test_python_args_reject_unsupported_override(tmp_path, value):
