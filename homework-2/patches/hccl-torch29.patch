+"""CPU tensor regressions for the optional final-projection precision override."""
+
+import argparse
+
+import pytest
+import torch
+import torch.nn.functional as F
+from transformers import PretrainedConfig
+
+import tokenspeed.runtime.layers.logits_processor as logits_processor_module
+from tokenspeed.runtime.execution.forward_batch_info import ForwardMode
+from tokenspeed.runtime.layers.dense.fp8 import Fp8LinearMethod
+from tokenspeed.runtime.layers.dense.unquant import UnquantizedLinearMethod
+from tokenspeed.runtime.layers.logits_processor import LogitsMetadata, LogitsProcessor
+from tokenspeed.runtime.layers.quantization.fp8 import Fp8Config
+from tokenspeed.runtime.layers.vocab_parallel_embedding import (
+    ParallelLMHead,
+    VocabParallelEmbedding,
+)
+from tokenspeed.runtime.utils.env import (
+    global_server_args_dict,
+    global_server_args_dict_update,
+)
+from tokenspeed.runtime.utils.server_args import ServerArgs
+
+
+@pytest.fixture(autouse=True)
+def isolated_launch_config(monkeypatch):
+    original = dict(global_server_args_dict)
+    global_server_args_dict.update(
+        numerics="auto", logprob_order="torch", lm_head_compute_dtype=None
+    )
+    monkeypatch.setenv("TOKENSPEED_MAMBA_SSM_DTYPE", "float32")
+    try:
+        yield
+    finally:
+        global_server_args_dict.clear()
+        global_server_args_dict.update(original)
+
+
+def _processor(vocab_size=2, **kwargs):
+    return LogitsProcessor(
+        PretrainedConfig(vocab_size=vocab_size), dp_lm_head_tp=False, **kwargs
+    )
+
+
+def _logits(processor, hidden, head, **kwargs):
+    return processor._get_logits(
+        hidden,
+        head,
+        LogitsMetadata(forward_mode=ForwardMode.DECODE, query_shard=None),
+        require_full_vocab=True,
+        **kwargs,
+    )
+
+
+def _server_args(model_dir, **kwargs):
+    return ServerArgs(
+        model=str(model_dir),
+        device="cpu",
+        world_size=1,
+        max_num_seqs=2,
+        sampling_backend="greedy",
+        disable_pdl=True,
+        **kwargs,
+    )
+
+
+class _MethodHead(torch.nn.Linear):
+    """A real dense tensor head with an explicit runtime projection method."""
+
+    def __init__(self, quant_method):
+        super().__init__(2, 2, bias=False, dtype=torch.float16)
+        self.quant_method = quant_method
+
+
+def test_float32_projection_breaks_a_half_rounding_tie_before_sampling():
+    hidden = torch.tensor([[1.0, 1 / 4096]], dtype=torch.float16)
+    head = torch.nn.Linear(2, 2, bias=False, dtype=torch.float16)
+    with torch.no_grad():
+        head.weight.copy_(torch.tensor([[1, 0], [1, 1]]))
+    metadata = LogitsMetadata(forward_mode=ForwardMode.DECODE, query_shard=None)
+    native = _processor()(None, hidden, head, metadata).next_token_logits
+    global_server_args_dict["lm_head_compute_dtype"] = "float32"
+    widened = _processor()(None, hidden, head, metadata).next_token_logits
+
+    assert native.dtype == torch.float16
+    assert native[0, 0] == native[0, 1]
+    assert native.float().argmax(-1).item() == 0  # Casting rounded logits is too late.
+    assert widened.dtype == torch.float32
+    assert widened[0, 1] > widened[0, 0]
+    assert widened.argmax(-1).item() == 1
+    torch.testing.assert_close(
+        widened, F.linear(hidden.float(), head.weight.float()), rtol=0, atol=0
+    )
+
+
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16, torch.float32])
+@pytest.mark.parametrize("head_kind", ["dense", "linear_method", "parallel", "tied"])
+def test_override_preserves_inputs_weights_and_tied_embeddings(dtype, head_kind):
+    global_server_args_dict["lm_head_compute_dtype"] = "float32"
+    embedding = None
+    if head_kind == "dense":
+        head = torch.nn.Linear(2, 2, bias=False, dtype=dtype)
+    elif head_kind == "linear_method":
+        head = _MethodHead(UnquantizedLinearMethod()).to(dtype=dtype)
+    else:
+        head = ParallelLMHead(2, 2, params_dtype=dtype, padding_size=1)
+        if head_kind == "tied":
+            embedding = VocabParallelEmbedding(2, 2, params_dtype=dtype, padding_size=1)
+            head.tie_weights(embedding)
+    hidden = torch.tensor([[1, 1 / 4096], [-2, 0.5]], dtype=dtype)
+    with torch.no_grad():
+        head.weight.copy_(torch.tensor([[1, 0], [1, 1]]))
+    weight = head.weight
+    hidden_before, weight_before = hidden.clone(), weight.clone()
+    bias = torch.tensor([1 / 8192, -1 / 8192], dtype=dtype)
+    proc = _processor()
+    proc.prepare_communication(head)
+    logits = _logits(proc, hidden, head, embedding_bias=bias)
+    assert logits.dtype == torch.float32
+    torch.testing.assert_close(
+        logits, F.linear(hidden.float(), weight.float(), bias.float()), rtol=0, atol=0
+    )
+    assert head.weight is weight
+    assert head.weight.dtype == hidden.dtype == dtype
+    assert torch.equal(hidden, hidden_before)
+    assert torch.equal(head.weight, weight_before)
+    if embedding is not None:
+        assert embedding.weight is weight
+        assert torch.equal(embedding.weight, weight_before)
+
+
+@pytest.mark.parametrize("dtype", [torch.float16, torch.bfloat16, torch.float32])
+def test_omission_retains_native_arithmetic_and_dtype(dtype):
+    # Both an absent dictionary key and an explicit None mean native semantics.
+    hidden = torch.tensor([[1, 1 / 4096], [-2, 0.5]], dtype=torch.float32)
+    head = torch.nn.Linear(2, 2, bias=False, dtype=dtype)
+    with torch.no_grad():
+        head.weight.copy_(torch.tensor([[1, 0], [1, 1]]))
+    expected = hidden.to(dtype) @ head.weight.T
+    for absent in (False, True):
+        if absent:
+            global_server_args_dict.pop("lm_head_compute_dtype", None)
+        got = _logits(_processor(), hidden, head)
+        assert got.dtype == dtype
+        torch.testing.assert_close(got, expected, rtol=0, atol=0)
+
+
+def test_override_is_not_narrowed_by_cpu_autocast():
+    global_server_args_dict["lm_head_compute_dtype"] = "float32"
+    head = torch.nn.Linear(2, 2, bias=False, dtype=torch.float16)
+    hidden = torch.tensor([[1, 1 / 4096]], dtype=torch.float16)
+    with torch.no_grad():
+        head.weight.copy_(torch.tensor([[1, 0], [1, 1]]))
+    with torch.autocast("cpu", dtype=torch.bfloat16):
+        logits = _logits(_processor(), hidden, head)
+    assert logits.dtype == torch.float32
+    assert logits.argmax(-1).item() == 1
+
+
+def test_override_uses_existing_vocab_gather_scale_and_padding(monkeypatch):
+    global_server_args_dict["lm_head_compute_dtype"] = "float32"
+    hidden = torch.tensor([[1, 1 / 4096]], dtype=torch.float16)
+    head = ParallelLMHead(
+        3, 2, params_dtype=torch.float16, padding_size=4,
+        tp_rank=0, tp_size=2, tp_group=(0, 1),
+    )
+    with torch.no_grad():
+        head.weight.copy_(torch.tensor([[1, 0], [1, 1]]))
+    other_weight = torch.tensor([[0, 1], [8, 8]], dtype=torch.float16)
+    other_logits = F.linear(hidden.float(), other_weight.float())
+
+    def gather(output, shard, group):
+        # Only the absent second process is substituted; arithmetic is real CPU torch.
+        output.copy_(torch.cat((shard, other_logits), dim=0))
+
+    monkeypatch.setattr(logits_processor_module, "all_gather_single", gather)
+    proc = _processor(
+        vocab_size=3, tp_rank=0, tp_size=2, tp_group=(0, 1), logit_scale=0.5
+    )
+    # Match the second rank's scale, which is applied before the gather.
+    other_logits.mul_(0.5)
+    got = _logits(proc, hidden, head)
+    expected = F.linear(hidden.float(), torch.cat((head.weight, other_weight)).float())
+    assert got.dtype == torch.float32
+    assert got.shape == (1, 3)
+    torch.testing.assert_close(got, expected[:, :3] * 0.5, rtol=0, atol=0)
+
+
+@pytest.mark.parametrize("at_startup", [False, True])
+@pytest.mark.parametrize("weightless", [False, True])
+def test_override_refuses_a_quantized_method(at_startup, weightless):
