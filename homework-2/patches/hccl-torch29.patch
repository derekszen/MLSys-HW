+"""CPU-only Qwen3.5 cache precision contracts, with no weights or kernels."""
+
+import argparse
+from pathlib import Path
+
+import pytest
+import torch
+
+from tokenspeed.runtime.layers.attention.configs.base import AttnConfig, resolve_dtype
+from tokenspeed.runtime.layers.attention.configs.linear_attn import LinearAttnConfig
+from tokenspeed.runtime.layers.attention.configs.mha import MHAConfig
+from tokenspeed.runtime.layers.attention.kv_cache.arena import CacheArena
+from tokenspeed.runtime.layers.attention.kv_cache.recipes.plan import pack
+from tokenspeed.runtime.layers.attention.kv_cache.recipes.qwen35 import QwenGDNRecipe
+from tokenspeed.runtime.layers.attention.kv_cache.recipes.spec import (
+    FULL_ATTENTION,
+    LINEAR_ATTENTION,
+)
+from tokenspeed.runtime.pd.cache_protocol import (
+    CacheContractError,
+    CacheTransferContract,
+    validate_cache_peer_layout,
+)
+from tokenspeed.runtime.utils.server_args import ServerArgs
+
+
+@pytest.fixture(autouse=True)
+def preserve_ssm_environment(monkeypatch):
+    # ServerArgs publishes the SSM setting; restore the caller's env afterwards.
+    monkeypatch.setenv("TOKENSPEED_MAMBA_SSM_DTYPE", "float32")
+
+
+def _server_args(model_dir: Path, **kwargs) -> ServerArgs:
+    return ServerArgs(
+        model=str(model_dir),
+        device="cpu",
+        world_size=1,
+        max_num_seqs=2,
+        sampling_backend="greedy",
+        disable_pdl=True,
+        **kwargs,
+    )
+
+
+def _recipe(
+    model_dir: Path,
+    *,
+    activation_dtype: torch.dtype,
+    kv_dtype: str,
+    ssm_dtype: str,
+) -> QwenGDNRecipe:
+    args = _server_args(model_dir, kv_cache_dtype=kv_dtype, mamba_ssm_dtype=ssm_dtype)
+    config = AttnConfig(
+        device="cpu",
+        dtype=activation_dtype,
+        kv_cache_dtype=resolve_dtype(args.kv_cache_dtype),
+        kv_cache_quant_method="none",
+        kv_cache_mxfp8=args.kv_cache_dtype == "mxfp8",
+        prefix_granularity=128,
+        context_len=256,
+        max_bs=2,
+        components=(
+            MHAConfig(
+                num_attention_heads=1,
+                num_kv_heads=1,
+                head_dim=8,
+                attn_tp_size=1,
+                cache_layer_types=(LINEAR_ATTENTION, FULL_ATTENTION),
+            ),
+            LinearAttnConfig(
+                num_k_heads=1,
+                num_v_heads=1,
+                head_k_dim=32,
+                head_v_dim=32,
+                conv_kernel_size=4,
+                layer_ids=(0,),
+                tp_size=1,
+            ),
+        ),
+    )
+    return QwenGDNRecipe(
+        server_args=args,
+        # Group declaration and packing use only the attention config; no
+        # checkpoint metadata or draft model is needed for these stages.
+        model_config=None,
+        attn_config=config,
+        draft_model_config=None,
+        draft_attn_config=None,
+        cache_budget_bytes=64 << 10,
+        probe_batch_rows=None,
+        decode_input_tokens=1,
+        overlap_schedule_depth=0,
+    )
+
+
+def _arena(recipe: QwenGDNRecipe) -> CacheArena:
+    groups = recipe.groups()
+    layout = pack(
+        groups,
+        prefix_granularity=recipe.prefix_granularity,
+        cache_blocks_per_lcm_block=recipe.packing(groups),
+        alignment=recipe.alignment,
+        max_padding_fraction=recipe.max_padding_fraction,
+    )
+    recipe.check_layout(layout)
+    return CacheArena(
+        layout.bind(2),
+        "cpu",
+        cache_group_specs=tuple(spec for spec, _ in groups),
+    )
+
+
+@pytest.mark.parametrize(
+    "activation_dtype", [torch.float16, torch.bfloat16, torch.float32]
+)
+@pytest.mark.parametrize("ssm_dtype", ["float32", "bfloat16"])
+@pytest.mark.parametrize("kv_dtype", ["auto", "float16"])
+def test_state_precision_follows_activation_not_kv(
+    tmp_path, activation_dtype, ssm_dtype, kv_dtype
+):
+    recipe = _recipe(
+        tmp_path,
+        activation_dtype=activation_dtype,
+        kv_dtype=kv_dtype,
+        ssm_dtype=ssm_dtype,
+    )
+    arena = _arena(recipe)
+    linear = recipe.attn_config.component(LinearAttnConfig)
+    for field_id, shape, dtype in (
+        ("layer.0.conv", linear.conv_state_shape, activation_dtype),
+        ("layer.0.ssm", linear.temporal_state_shape, getattr(torch, ssm_dtype)),
+    ):
+        field = arena.plan.field(field_id)
+        view = arena.field(field_id)
+        assert field.dtype == str(dtype).removeprefix("torch.")
+        assert field.shape == shape
+        assert field.element_size == dtype.itemsize
+        assert view.dtype == dtype
+        assert view.shape == (arena.plan.group(field.group_id).page_count, *shape)
+        assert view.stride(0) * view.element_size() == field.page_stride_bytes
+        sample = torch.full(shape, 1.25, dtype=dtype)
+        view[1].copy_(sample)
+        assert torch.equal(view[1], sample)
+        assert torch.count_nonzero(view[0]).item() == 0
+    expected_kv_dtype = torch.float16 if kv_dtype == "float16" else torch.bfloat16
+    for field_id in ("layer.1.k", "layer.1.v"):
+        assert arena.field(field_id).dtype == expected_kv_dtype
+    assert arena.plan.arena_bytes < 64 << 10
+
