+
+def test_invalid_kv_dtype_rejected_for_python_and_cli(tmp_path):
+    with pytest.raises(ValueError, match="--kv-cache-dtype must be one of"):
+        _server_args(tmp_path, kv_cache_dtype="float32")
+    with pytest.raises(ValueError, match="Unsupported kv_cache_dtype"):
+        resolve_dtype("float32")
+    parser = argparse.ArgumentParser()
+    ServerArgs.add_cli_args(parser)
+    with pytest.raises(SystemExit):
+        parser.parse_args(["--model", str(tmp_path), "--kv-cache-dtype", "float32"])
+
+
+@pytest.mark.parametrize("kv_dtype", ["fp8", "fp8_e4m3"])
+def test_fp8_scatter_storage_is_unchanged(tmp_path, kv_dtype):
+    arena = _arena(
+        _recipe(
+            tmp_path,
+            activation_dtype=torch.float16,
+            kv_dtype=kv_dtype,
+            ssm_dtype="float32",
+        )
+    )
+    assert arena.field("layer.0.conv").dtype == torch.float16
+    assert arena.field("layer.0.ssm").dtype == torch.float32
+    for field_id in ("layer.1.k", "layer.1.v"):
+        assert arena.plan.field(field_id).dtype == "uint8"
+        assert arena.field(field_id).dtype == torch.uint8
+
+
+def test_qwen_mxfp8_remains_unsupported(tmp_path):
+    with pytest.raises(RuntimeError, match="MXFP8 interleaved"):
+        _recipe(
+            tmp_path,
+            activation_dtype=torch.float16,
+            kv_dtype="mxfp8",
+            ssm_dtype="float32",
+        )
+
+
+@pytest.mark.parametrize("field_id", ["layer.0.conv", "layer.1.k"])
+def test_two_byte_dtypes_keep_distinct_wire_and_storage_semantics(tmp_path, field_id):
+    contracts = []
+    samples = []
+    for dtype in (torch.float16, torch.bfloat16):
+        arena = _arena(
+            _recipe(
+                tmp_path,
+                activation_dtype=(
+                    dtype if field_id.endswith("conv") else torch.bfloat16
+                ),
+                kv_dtype=(
+                    str(dtype).removeprefix("torch.")
+                    if field_id.endswith("k")
+                    else "auto"
+                ),
+                ssm_dtype="float32",
+            )
+        )
+        contract = CacheTransferContract(arena.plan, arena.cache_group_specs)
+        restored = CacheTransferContract.from_wire_bytes(contract.to_wire_bytes())
+        assert restored == contract
+        assert restored.field_dtype(field_id) == str(dtype).removeprefix("torch.")
+        validate_cache_peer_layout(contract, restored)
+        contracts.append(restored)
+        sample = arena.field(field_id)[1]
+        sample.fill_(1.25)
+        samples.append(sample.contiguous().view(torch.uint8).clone())
+    fp16, bf16 = contracts
+    assert fp16.plan.arena_bytes == bf16.plan.arena_bytes
+    assert (
+        fp16.plan.field(field_id).payload_bytes
+        == bf16.plan.field(field_id).payload_bytes
+    )
+    assert (
+        fp16.plan.field(field_id).element_size
+        == bf16.plan.field(field_id).element_size
+        == 2
+    )
+    assert fp16.to_wire_bytes() != bf16.to_wire_bytes()
+    assert not torch.equal(*samples)
+    with pytest.raises(CacheContractError, match=rf"field '{field_id}'.*semantics"):
+        validate_cache_peer_layout(fp16, bf16)
